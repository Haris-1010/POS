@{
    ViewBag.Title = "DailySalesReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/panel-assets/plugins/bootstrap-datepicker/bootstrap-datepicker.min.css" rel="stylesheet" />
}

@* Filter part starting.... *@
<div class="card">
    <div class="card-header">
        <h3 class="card-title primary-text font-weight-bold"><i class="fas fa-filter"></i> Filters</h3>
        <div class="card-tools">
            <button class="btn btn-tool" type="button" data-toggle="collapse" data-target="#filterCard" aria-expanded="false" aria-controls="filterCard">
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
    <div class="collapse" id="filterCard">
        <div class="card-body">
            <form id="filterForm">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Date</label>
                            <input type="text" class="form-control" name="Date" autocomplete="off" placeholder="Select a date">
                        </div>
                    </div>
                    @*<div class="col-md-3 col-sm-6">
                            <div class="form-group">
                                <label for="">Cashier/User</label>
                                <select class="form-control js-select2" name="SalePersonUsername">
                                    <option value="">Choose Cashier/User</option>
                                    <option value="@user.Username">@user.Name</option>
                                </select>
                            </div>
                        </div>*@
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Suppliers</label>
                            <select class="form-control js-select2" name="SupplierID" required>
                                <option value="">Choose Supplier</option>
                                @if (Model != null && Model.Suppliers != null && Model.Suppliers.Count > 0)
                                {
                                    foreach (var item in Model.Suppliers)
                                    {
                                        <option value="@item.ID">@item.Name</option>
                                    }
                                }
                                else
                                {
                                    <option disabled>No Suppliers available</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label for="">Manufacturers</label>
                            <select class="form-control js-select2" name="ManufacturerID">
                                <option value="">Choose Manufacturer</option>
                                @if (Model != null && Model.Manufacturers != null && Model.Manufacturers.Count > 0)
                                {
                                    foreach (var item in Model.Manufacturers)
                                    {
                                        <option value="@item.ID">@item.Name</option>
                                    }
                                }
                                else
                                {
                                    <option disabled>No Manufacturers available</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Brands</label>
                            <select class="form-control js-select2" name="BrandID" required>
                                <option value="">Choose Brand</option>
                                @if (Model != null && Model.Brands != null && Model.Brands.Count > 0)
                                {
                                    foreach (var item in Model.Brands)
                                    {
                                        <option value="@item.ID">@item.Title</option>
                                    }
                                }
                                else
                                {
                                    <option disabled>No Brands available</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Payment type</label>
                            <select class="form-control js-select2 js-payment-mode" name="PaymentMode">
                                <option value="Cash">Cash</option>
                                <option value="JazzCash">JazzCash</option>
                                <option value="EasyPaisa">EasyPaisa</option>
                                <option value="Card">Card</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Sort By</label>
                                    <select class="form-control js-select2" name="SortBy">
                                        <option value="InvoiceNo" selected>Latest</option>
                                        <option value="DateTime">Date</option>
                                        <option value="CustomerName">Customer</option>
                                        <option value="ItemsCount">Items Count</option>
                                        <option value="InvoiceNo">Invoice No</option>
                                        <option value="TotalQty">Qty</option>
                                        <option value="NetAmount">Total</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 pl-0">
                                <div class="form-group">
                                    <label>Order</label>
                                    <select class="form-control js-select2" name="SortByOrder">
                                        <option value="ASC" selected>Ascending</option>
                                        <option value="DESC">Descending</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3 ml-auto">
                        <div class="form-group mb-0 d-flex justify-content-between">
                            <label></label>
                            <button type="button" class="btn btn-primary-custom form-control text-nowrap js-apply-filter-btn">Apply Filter</button>
                            <button type="button" class="btn btn-default form-control js-clear-filter-btn ml-2">Clear Filter</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <input type="hidden" value="@Model.CurrencySymbol" class="form-control" id="currency">
    </div>
</div>
@* Filter part ending .... *@

@* Table part starting ... *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-baseline">
        <h3 class="card-title primary-text font-weight-bold">Daily Sales Report</h3>
    </div>
    <div class="card-body">
        <table id="reportTable" class="table table-hover w-100 table-responsive-sm">
            <thead>
                <tr>
                    <th>Invoice NO</th>
                    <th>Date</th>
                    <th>Patient</th>
                    <th>Items Count</th>
                    <th>Total Qty</th>
                    <th>Gross Amount</th>
                    <th>Discount</th>
                    <th>Net Amount</th>
                </tr>
            </thead>
            <tbody>
                @*<tr>
                        <td>INST/49</td>
                        <td>13 May 2025</td>
                        <td>Mahnoor jaffar</td>
                        <td>3</td>
                        <td>30</td>
                        <td>1,700</td>
                        <td>20</td>
                        <td>1,680</td>
                    </tr>*@
            </tbody>
            <tfoot>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
@* Table part ending .... *@
@section Scripts{
    <script>

        var GetPagedDailySalesReportUrl = '@Url.Action("GetPagedDailySalesReport", "Reports")';
    </script>
    <script src="~/panel-assets/plugins/DateRange/moment.min.js"></script>
    <script src="~/panel-assets/plugins/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>
    <script src="~/JSModels/Reports/dailySalesReport.js"></script>
}