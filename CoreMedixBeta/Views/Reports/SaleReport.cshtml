@{
    ViewBag.Title = "SaleReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model CoreMedixBeta.Models.Reports.SaleReportVM
@section Styles
{
    <style>
        
        .radio-inline {
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer !important;
        }

        .radio-input {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            width: 16px;
            height: 16px;
            border: 2px solid var(--cm-accent-ink);
            border-radius: 50%;
            background-color: white;
            outline: none;
            position: relative;
            transition: .3s all;
            cursor: pointer !important;
        }

            .radio-input:checked {
                background-color: var(--cm-accent);
            }

                .radio-input:checked::before {
                    content: "";
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    width: 5px;
                    height: 5px;
                    border-radius: 50%;
                    background-color: white;
                }

            .radio-input:hover {
                opacity: 0.8;
            }
    </style>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title primary-text font-weight-bold"><i class="fas fa-filter"></i> Filters</h3>
        <div class="card-tools">
            <button class="btn btn-tool" type="button" data-toggle="collapse" data-target="#filterCard" aria-expanded="false" aria-controls="filterCard">
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
    <div class="collapse" id="filterCard">
        <div class="card-body">
            <form id="filterForm">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Date</label>
                            <input type="text" class="form-control" name="Date" autocomplete="off" placeholder="Select a date range">
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Suppliers</label>
                            <select class="form-control js-select2" name="SupplierID" required>
                                <option value="">Choose Supplier</option>
                                @if (Model != null && Model.Suppliers != null && Model.Suppliers.Count > 0)
                                {
                                    foreach (var item in Model.Suppliers)
                                    {
                                        <option value="@item.ID">@item.Name</option>
                                    }
                                }
                                else
                                {
                                    <option disabled>No Suppliers available</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label for="">Manufacturers</label>
                            <select class="form-control js-select2" name="ManufacturerID" required>
                                <option value="">Choose Manufacturer</option>
                                @if (Model != null && Model.Manufacturers != null && Model.Manufacturers.Any())
                                {
                                    foreach (var item in Model.Manufacturers)
                                    {
                                        <option value="@item.ID">@item.Name</option>
                                    }
                                }
                                else
                                {
                                    <option disabled>No Manufacturers available</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Brands</label>
                            <select class="form-control js-select2" name="BrandID" required>
                                <option value="">Choose Brand</option>
                                @if (Model != null && Model.Brands != null && Model.Brands.Count > 0)
                                {
                                    foreach (var item in Model.Brands)
                                    {
                                        <option value="@item.ID">@item.Title</option>
                                    }
                                }
                                else
                                {
                                    <option disabled>No Brands available</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Sort By</label>
                                    <select class="form-control js-select2" name="SortBy">
                                        <option value="ID" selected>Latest</option>
                                        <option value="DateTime">Date</option>
                                        <option value="ManufacturerName">Manufacturer</option>
                                        <option value="ItemName">Item Name</option>
                                        <option value="Qty">Qty</option>
                                        <option value="LineTotal">Total</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 pl-0">
                                <div class="form-group">
                                    <label>Order</label>
                                    <select class="form-control js-select2" name="SortByOrder">
                                        <option value="ASC" selected>Ascending</option>
                                        <option value="DESC">Descending</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6">
                        <div class="form-group">
                            <label class="m-0">Group By</label>
                            <div class="d-flex mt-2">
                                <div class="radio-inline mr-3">
                                    <input type="radio" class="radio-input" name="GroupBy" value="ManufacturerName" id="groupByManufacturer">
                                    <label for="groupByManufacturer" class="m-0 font-weight-normal">Manufacturer</label>
                                </div>
                                <div class="radio-inline mr-3">
                                    <input type="radio" class="radio-input" name="GroupBy" value="ItemName" id="groupByItemName">
                                    <label for="groupByItemName" class="m-0 font-weight-normal text-nowrap">Item Name</label>
                                </div>
                                <div class="radio-inline">
                                    <input type="radio" class="radio-input" name="GroupBy" value="DateTime" id="groupByDate">
                                    <label for="groupByDate" class="m-0 font-weight-normal">Date</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3 ml-auto">
                        <div class="form-group mb-0 d-flex justify-content-between">
                            <label></label>
                            <button type="button" class="btn btn-primary-custom form-control text-nowrap js-apply-filter-btn">Apply Filter</button>
                            <button type="button" class="btn btn-default form-control js-clear-filter-btn ml-2">Clear Filter</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <input type="hidden" value="@Model.CurrencySymbol" class="form-control" id="currency">
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-baseline">
        <h3 class="card-title primary-text font-weight-bold">Sales Report</h3>
    </div>
    <div class="card-body">
        <table id="reportTable" class="table table-hover w-100 table-responsive-sm">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Patient</th>
                    @*<th>Referred By</th>*@
                    <th>Manufacturer</th>
                    <th>Item Name</th>
                    <th>Qty</th>
                    <th>Rate Per Unit</th>
                    <th>Total</th>
                    @*<th>Actions</th>*@
                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
<div id="saleReportData" data-startdate="@Model.StartDate" data-enddate="@Model.EndDate"></div>

@*<form id="permissionsForm">
        <input type="hidden" name="isEMRIntegrationAllowed" value="@(user.IntegrateEMRInCoreMedixPharmacy ? "1" : "0")" />
    </form>*@

@section Scripts{
    <script> 
        var GetPagedSaleReportUrl = '@Url.Action("GetPagedSaleReport", "Reports")';
    </script>
    <script src="~/panel-assets/plugins/DateRange/moment.min.js"></script>
    <script src="~/panel-assets/plugins/DateRange/daterangepicker.js"></script>
    <script src="~/JSModels/Reports/saleReport.js"></script>
}
