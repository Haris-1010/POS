@{
    ViewBag.Title = "InventoryMovementReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
}

@* Filter part starting.... *@
<div class="card">
    <div class="card-header">
        <h3 class="card-title primary-text font-weight-bold"><i class="fas fa-filter"></i> Filters</h3>
        <div class="card-tools">
            <button class="btn btn-tool" type="button" data-toggle="collapse" data-target="#filterCard" aria-expanded="false" aria-controls="filterCard">
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
    <div class="collapse" id="filterCard">
        <div class="card-body">
            <form id="filterForm">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Date</label>
                            <input type="text" class="form-control" name="Date" autocomplete="off" placeholder="Select a date range">
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label for="">Varient</label>
                            <select class="form-control js-select2" name="VarientID">
                                <option value="">Choose Category</option>
                                @if (Model.AllAttributes != null && Model.AllAttributes.Count > 0)
                                {
                                    foreach (var Attribute in Model.AllAttributes)
                                    {
                                        if (Attribute.Type == "Formation")
                                        {
                                            <option value="@Attribute.ID">@Attribute.Name</option>
                                        }
                                    }
                                }
                                else
                                {
                                    <option disabled>No Varients available</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label for="">Category</label>
                            <select class="form-control js-select2" name="CategoryID">
                                <option value="">Choose Category</option>
                                @if (Model.AllAttributes != null && Model.AllAttributes.Count > 0)
                                {
                                    foreach (var Attribute in Model.AllAttributes)
                                    {
                                        if (Attribute.Type == "Category")
                                        {
                                            <option value="@Attribute.ID">@Attribute.Name</option>
                                        }
                                    }
                                }
                                else
                                {
                                    <option disabled>No Categories available</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label for="">Manufacturers</label>
                            <select class="form-control js-select2" name="ManufacturerID">
                                <option value="">Choose Manufacturer</option>
                                @if (Model != null && Model.Manufacturers != null && Model.Manufacturers.Count > 0)
                                {
                                    foreach (var item in Model.Manufacturers)
                                    {
                                        <option value="@item.ID">@item.Name</option>
                                    }
                                }
                                else
                                {
                                    <option disabled>No Manufacturers available</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Suppliers</label>
                            <select class="form-control js-select2" name="SupplierID">
                                <option value="">Choose Supplier</option>
                                @if (Model != null && Model.Suppliers != null && Model.Suppliers.Count > 0)
                                {
                                    foreach (var item in Model.Suppliers)
                                    {
                                        <option value="@item.ID">@item.Name</option>
                                    }
                                }
                                else
                                {
                                    <option disabled>No Suppliers available</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Product</label>
                            <input type="text" value="" name="SearchItem" autocomplete="off" class="form-control js-search-item" required placeholder="Eg: Panadol" />
                            <input type="hidden" value="" name="ItemID">
                            <input type="hidden" value="" name="VariationID">
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Sort By</label>
                                    <select class="form-control js-select2" name="SortBy">
                                        <option value="ID" selected>Latest</option>
                                        <option value="ProductName">Product</option>
                                        <option value="TimeStamp">Date</option>
                                        <option value="Qty">Qty</option>
                                        <option value="Balance">Balance</option>
                                        <option value="ReferenceNo">Reference No</option>
                                        <option value="Qty">Qty</option>
                                        <option value="TransactionType">Transaction Type</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 pl-0">
                                <div class="form-group">
                                    <label>Order</label>
                                    <select class="form-control js-select2" name="SortByOrder">
                                        <option value="ASC" selected>Ascending</option>
                                        <option value="DESC">Descending</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3 ml-auto">
                        <div class="form-group mb-0 d-flex justify-content-between">
                            <label></label>
                            <button type="button" class="btn btn-primary-custom form-control text-nowrap js-apply-filter-btn">Apply Filter</button>
                            <button type="button" class="btn btn-default form-control js-clear-filter-btn ml-2">Clear Filter</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <input type="hidden" value="@Model.CurrencySymbol" class="form-control" id="currency">
    </div>
</div>
@* Filter part ending .... *@

@* Table part starting ... *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-baseline">
        <h3 class="card-title primary-text font-weight-bold">Inventory Movement Report</h3>
    </div>
    <div class="card-body">
        <table id="reportTable" class="table table-hover w-100 table-responsive-sm">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Date</th>
                    <th>Transaction Type</th>
                    <th>Qty</th>
                    <th>Balance</th>
                    <th>Reference No</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
@* Table part ending .... *@
@section Scripts{
    <script>

     var SearchItemsUrl = '@Url.Action("SearchItems", "InventoryItems")';
        var GetInventoryMovementReportUrl = '@Url.Action("GetInventoryMovementReport", "Reports")';
    </script>
    <script src="~/panel-assets/plugins/DateRange/moment.min.js"></script>
    <script src="~/panel-assets/plugins/DateRange/daterangepicker.js"></script>
    <script src="~/JSModels/Reports/inventoryMovementReport.js"></script>
}