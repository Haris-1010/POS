@{
    ViewBag.Title = "InvoicePrefix";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model CoreMedixBeta.Models.InventorySettings.InvoiceSetting

<div class="card">
    <div class="card-header">
        <h4>Invoice Prefix & Currency Settings </h4>
    </div>
    <div class="card-body" style="min-height:20vh !important;">
        <form id="InvoicePerfixForm">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="">Invoice Prefix</label>
                        <input class="form-control" name="InvoicePrefix" placeholder="INV" value="@Model.InvoicePrefix" />
                        <input type="hidden" name="ID" value="@Model.ID" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="">Currency Setting </label>
                        <input class="form-control" name="Currency" placeholder="$" value="@Model.Currency" />
                        <input type="hidden" name="ID" value="@Model.ID" />
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="card-footer">
        <div class="row no-print">

            <div class="col-12">
                <button type="button" class="btn  btn-success js-save-btn float-left">
                    <i class="far fa-save"></i> Update
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>

        var SaveInvoiceSettingUrl = '@Url.Action("SaveInvoiceSetting", "InventorySettings")';
    </script>
    <script src="~/JSModels/InventorySettings/invoicePrefix.js"></script>
}