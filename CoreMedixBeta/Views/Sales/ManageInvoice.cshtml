@model CoreMedixBeta.Models.Sales.ManageInvoiceVM
@{
    ViewBag.Title = "ManageInvoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Newtonsoft
@using CoreMedixBeta.Models.Sales
@using CoreMedixBeta.Models.Sales.DTOs
@using CoreMedixBeta.Models.ReferralContacts
@using CoreMedixBeta.Models.Patient
@{

    SaleInvoiceDto SaleInvoice = Model != null && Model.Invoice != null ? Model.Invoice.SaleInvoice : null;
    SaleInvoiceFinancialDetail SaleInvoiceFinancialDetails = Model != null && Model.Invoice != null ? Model.Invoice.SaleInvoiceFinancialDetails : null;

    bool isUpdate = SaleInvoice != null && SaleInvoice.ID > 0;
}

@section Styles{
    <link href="~/panel-assets/plugins/bootstrap-datepicker/bootstrap-datepicker.min.css" rel="stylesheet" />
    <link href="~/CSSModels/Sales/ManageInvoice.css" rel="stylesheet" />
    <style>
        .datepicker {
            z-index: 1051 !important;
        }
    </style>
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Invoice Information</h3>
    </div>
    <form id="saleInfoForm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="">Invoice Number#</label>
                        <p style="background-color: var(--cm-surface-alt); border: 1px solid var(--cm-border); color: var(--cm-text); padding: 6px; border-radius: 3px;">@(isUpdate ? SaleInvoice.InvoiceNo : "Draft")</p>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="">Patient<span class="required">*</span></label>
                        @if (Model.ReferralOrderID > 0)
                        {
                            <input type="text" value="@Model.CustomerName" name="SearchCustomer" autocomplete="off" class="form-control js-search-customer" required placeholder="Eg: 03001234450" readonly />
                            <input type="hidden" name="CustomerID" value="@Model.CustomerID" required>
                            <input type="hidden" name="CustomerType" value="@Model.CustomerType" required>
                        }
                        else
                        {
                            <input type="text" value="@(isUpdate ? SaleInvoice.CustomerName : string.Empty)" name="SearchCustomer" autocomplete="off" class="form-control js-search-customer" required placeholder="Eg: 03001234450" />
                            <input type="hidden" name="CustomerID" value="@(isUpdate ? SaleInvoice.CustomerID : string.Empty)" required>
                            <input type="hidden" name="CustomerType" value="@(isUpdate ? SaleInvoice.CustomerType : string.Empty)" required>
                        }
                    </div>
                </div>

                @*<div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Referred By</label>
                            <select class="form-control js-select2 js-doctors" name="ReferredBy">
                                <option value="">Select Referred By</option>
                            </select>
                        </div>
                    </div>*@
                <div class="col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="">Invoice Date<span class="required">*</span></label>
                        @if (isUpdate)
                        {
                            <input type="text" class="form-control js-date-picker" name="InvoiceDate" value="@(SaleInvoice.InvoiceDate.ToString("MM/dd/yyyy"))" required />
                        }
                        else
                        {
                            <input type="text" class="form-control js-date-picker" name="InvoiceDate" placeholder="Select a date" required />
                        }
                    </div>
                </div>
                @*<div class="col-md-6">
                    <div class="form-group">
                        <label for="">Remarks</label>
                        <textarea class="form-control" rows="1" name="Remarks" placeholder="Add remarks here...">@(isUpdate ? SaleInvoice.Remarks : string.Empty)</textarea>
                    </div>
                </div>*@
            </div>
        </div>
        <input type="hidden" name="ID" value="@(isUpdate ? SaleInvoice.ID : 0)" />
        @*<input type="hidden" name="CreatedBy" value="@user.Username" required />
            <input type="hidden" name="LastModifiedBy" value="@user.Username" required />
            <input type="hidden" name="LocationID" value="@user.LocationID" required />
            <input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@
        <input type="hidden" name="InvoiceDateInCaseOfUpdate" value="@SaleInvoice.InvoiceDate" />
        <input type="hidden" name="ReferralOrderID" value="@Model.ReferralOrderID" />
        <input type="hidden" name="InvoiceNo" value="@(isUpdate ? SaleInvoice.InvoiceNo : Model.InvoicePrefix)" />
        @*<input type="hidden" name="DoctorUsernameInCaseOfUpdate" value="@SaleInvoice.DoctorUsername" />*@
    </form>
</div>

<div class="card">
    <div class="card-header">
        <p class="m-0">Find and add items or variations to the invoice seamlessly.</p>
        <form id="itemSearchForm">
            <div class="row">
                <div class="col-md-2">
                    <div class="form-group m-0">
                        <label>Search By</label>
                        <select class="form-control" name="SearchType">
                            <option value="Item" selected>Item</option>
                            <option value="Variation">Variation</option>
                            <option value="Salt">Generic</option>
                            <option value="Alternate">Alternate</option>
                            <option value="">All Above</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label for="">Manufacturer</label>
                    <select class="form-control js-select2" name="ManufacturerID" required>
                        <option value="0">Choose Manufacturer</option>
                        @if (Model != null && Model.Manufacturers != null && Model.Manufacturers.Count > 0)
                        {
                            foreach (var Manufacturers in Model.Manufacturers)
                            {
                                <option value="@Manufacturers.ID">@Manufacturers.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2 col-sm-12">
                    <div class="form-group">
                        <label for="">Supplier</label>
                        <select class="form-control js-select2" name="SupplierID">
                            <option value="0">Choose Supplier</option>
                            @if (Model != null && Model.Suppliers != null && Model.Suppliers.Count > 0)
                            {
                                foreach (var Supplier in Model.Suppliers)
                                {
                                    <option value="@Supplier.ID">@Supplier.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="form-group m-0">
                        <label>Search Item</label>
                        <input type="text" value="" name="SearchItem" autocomplete="off" class="form-control js-search-item" required placeholder="Eg: Panadol" />
                    </div>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label>Near To Expire</label>
                    <br>
                    <div class="checkbox-wrapper-7">
                        <input class="tgl tgl-ios js-switch" id="NearToExpire" name="NearToExpire" type="checkbox" />
                        <label class="tgl-btn" for="NearToExpire"></label>
                    </div>
                </div>
            </div>
            @*<input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive w-100">
            <table class="table table-hover table-bordered table-striped w-100" id="saleItemsTable">
                <thead style="background-color:var(--cm-surface-alt)">
                    <tr>
                        <th class="cutom-th">Name</th>
                        <th class="cutom-th" style="width:6% !important">Rack</th>
                        <th class="cutom-th" style="width:10% !important">Qty</th>
                        <th class="cutom-th" style="width:5% !important">Unit Price</th>
                        @*<th class="cutom-th">Discount Type</th>*@
                        <th class="cutom-th">Discount</th>
                        <th class="cutom-th" title="Unit Price Inc Tax" style="width:6% !important">USP (Inc. Tax)</th>
                        <th class="cutom-th" style="width:15% !important">Line Total</th>
                        <th class="cutom-th" style="width:5% !important"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (isUpdate)
                    {
                        if (Model.Invoice.SaleInvoiceItems != null && Model.Invoice.SaleInvoiceItems.Count > 0)
                        {
                            foreach (var item in Model.Invoice.SaleInvoiceItems)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td></td>
                                    <td>
                                        <input type="hidden" name="ItemID" value="@item.ItemID">
                                        <input type="hidden" name="VariationID" value="@item.VariationID">
                                        <input type="number" class="form-control" style="width:70%" name="Qty" placeholder="Enter Quantity" value="@item.Qty">
                                    </td>
                                    <td>@item.UnitCost</td>
                                    <td>
                                        <div class="d-flex border-0">
                                            <select class="form-control js-discount-list" name="DiscountID" data-rowindex="@item.ID" style="min-width:5rem !important; font-size:.8rem !important;">
                                                <option value="0" data-discount-type="select" data-discount-value="0" @(item.DiscountID == 0 ? "selected" : "")>Select Discount</option>
                                                @foreach (var discount in Model.Discounts)
                                                {
                                                    <option value="@discount.ID"
                                                            data-discount-type="@discount.DiscountType"
                                                            data-discount-value="@discount.DiscountValue"
                                                            @(item.DiscountID == discount.ID ? "selected" : "")>
                                                        @discount.DiscountName
                                                    </option>
                                                }
                                                <option value="0" data-discount-type="custom" data-discount-value="0" @(item.DiscountID == 0 && item.Discount > 0 ? "selected" : "")>Custom</option>
                                            </select>
                                            <select class="form-control js-discount-type" name="DiscountType" data-rowindex="@item.ID" style="@(item.DiscountID == 0 && item.Discount > 0 ? "display:block;" : "display:none;") margin-inline:5px !important; min-width:5rem !important; font-size:.8rem !important;">
                                                <option value="value" @(item.DiscountType == "value" ? "selected" : "")>In Value</option>
                                                <option value="percentage" @(item.DiscountType == "percentage" ? "selected" : "")>Percentage</option>
                                            </select>
                                            <input type="number" class="form-control" style="width:60%;@(item.DiscountID == 0 && item.Discount > 0 ? "display:block;" : "display:none;")" name="Discount" placeholder="Enter Discount" min="0" value="@item.Discount">
                                        </div>
                                    </td>
                                    <td>
                                        <input type="hidden" name="ItemTax" value="@item.ItemTax">
                                        <input type="text" class="form-control" style="width:100%" name="UnitCostWithTax" value="@item.UnitSalePriceInclusiveTax" readonly>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" style="width:100%" name="LineTotal" value="@item.LineTotal" readonly>
                                        <input type="hidden" name="TransactionStatus" value="UPDATED" />
                                    </td>
                                    <td>
                                        <button class="btn btn-danger btn-sm tip js-remove-item-btn" title="Delete Item" type="button">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="card-title">
            Payment Details
        </div>
    </div>
    <div class="card-body">
        @* Sub Total, Discount Type, Discount *@
        <div>
            <form id="saleCalculationsForm">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Subtotal</label>
                            <input type="number" name="SubTotal" value="@SaleInvoiceFinancialDetails.SubTotal" class="form-control" readonly>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="DiscountType">Discount Type</label>
                            <select class="form-control js-discount-type" name="DiscountType">
                                <option value="value" @(SaleInvoiceFinancialDetails.DiscountType == "value" ? "selected" : "")>Value</option>
                                <option value="percentage" @(SaleInvoiceFinancialDetails.DiscountType == "percentage" ? "selected" : "")>Percentage</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Discount Amount</label>
                            <input type="number" class="form-control" name="DiscountAmount" value="@SaleInvoiceFinancialDetails.DiscountAmount" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Subtotal After Discount</label>
                            <input type="number" class="form-control" name="SubtotalAfterDiscount" value="@SaleInvoiceFinancialDetails.SubtotalAfterDiscount" readonly />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Sales Tax</label>
                            <select class="form-control js-select2" name="TaxID">
                                <option value="0">Select Sales Tax</option>
                                @if (Model.Taxes != null && Model.Taxes.Count > 0)
                                {
                                    foreach (var item in Model.Taxes)
                                    {
                                        <option value="@item.ID"
                                                @(SaleInvoiceFinancialDetails.TaxID == item.ID ? "selected" : "") data-percentage="@item.Percentage"
                                                data-payment-mode="@item.PaymentMode">
                                            @item.Title
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Subtotal After Tax</label>
                            <input type="number" class="form-control" name="SubtotalAfterTax" value="@SaleInvoiceFinancialDetails.SubtotalAfterTax" readonly />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Paid</label>
                            <input type="number" class="form-control" name="PaidAmount" value="@SaleInvoiceFinancialDetails.PaidAmount" readonly />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Remaining</label>
                            <input type="number" class="form-control" name="RemainingAmount" value="@SaleInvoiceFinancialDetails.RemainingAmount" readonly />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Return Amount</label>
                            <input type="number" class="form-control" name="ReturnAmount" value="@SaleInvoiceFinancialDetails.ReturnAmount" readonly />
                        </div>
                    </div>
                </div>
            </form>
        </div>

        @* Add payment details *@
        @*<div class="pr-5">*@
        <div>
            <div class="card-header pl-0 pr-2">
                @*<h3 class="card-title font-weight-bold">Payment Details</h3>*@
                <div class="card-tools">
                    <button class="btn btn-primary-custom" id="addPaymentBtn">Add Payment</button>
                </div>
            </div>
            <div class="card-body px-0">
                <table class="table table-striped table-hover" id="paymentItemsTable">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:20% !important">Date</th>
                            <th style="width:20% !important">Amount</th>
                            <th style="width:25% !important">Mode</th>
                            <th style="width:25% !important">Attachement</th>
                            <th style="width:10% !important">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isUpdate)
                        {
                            if (Model.Invoice.SaleInvoicePayments != null && Model.Invoice.SaleInvoicePayments.Count > 0)
                            {
                                foreach (var item in Model.Invoice.SaleInvoicePayments)
                                {
                                    <tr>
                                        <td>
                                            <input type="hidden" class="form-control" name="TransactionType" value="@item.TransactionType">
                                            <input type="text" class="form-control js-datepicker" value="@(item.Date)" name="Date" placeholder="Enter date" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control" name="PaymentAmount" value="@item.PaidAmount" placeholder="Enter amount" />
                                        </td>
                                        <td>
                                            <select class="form-control js-select2" name="PaymentMode">
                                                <option value="Cash" @(item.PaymentMode == "Cash" ? "selected" : "")>Cash</option>
                                                <option value="Card" @(item.PaymentMode == "Card" ? "selected" : "")>Card</option>
                                                <option value="JazzCash" @(item.PaymentMode == "JazzCash" ? "selected" : "")>JazzCash</option>
                                                <option value="EasyPaisa" @(item.PaymentMode == "EasyPaisa" ? "selected" : "")>EasyPaisa</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="file" class="form-control js-attachment" name="Attachment" />
                                            <input type="hidden" class="js-attachment-url" name="AttachmentURL" value="@item.AttachmentURL" />
                                        </td>
                                        <td class="actions-td">
                                            @if (!string.IsNullOrEmpty(item.AttachmentURL))
                                            {
                                                <button class="btn btn-secondary text-white btn-sm tip js-view-img-btn"
                                                        title="View Image" type="button">
                                                    <i class="fa fa-eye text-white"></i>
                                                </button>
                                            }

                                            <button class="btn btn-danger btn-sm mt-1 tip js-remove-payment-btn" title="Delete Payment" type="button">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="row d-flex justify-content-end">
            <div class="col-4 d-flex justify-content-between">
                <button type="button" id="saveInvoiceBtn" class="btn btn-block btn-success float-right mr-1 mt-0" disabled>
                    Save Invoice
                </button>
                <button type="button" id="saveAndPrintInvoiceBtn" class="btn btn-block btn-primary-custom ml-2 mt-0" disabled>
                    Save & Print
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Add Customer Modal -->
<div class="modal fade" id="saveCustomerModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title primary-text font-weight-bold ">Save Patient</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Name<span class="required">*</span></label>
                                <input type="text" class="form-control" name="Name" required maxlength="@Patients.MaxNameLength" placeholder="Enter Patient name" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="number" class="form-control" name="Phone" maxlength="@Patients.MaxPhoneLength" placeholder="e.g 03xxxxxxxxx" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Date of Birth</label>
                                <input type="hidden" name="DOBInCaseOfUpdate" value="@(Model.Patient?.DOB)" />
                                @{
                                    string dobValue = "";
                                    if (!string.IsNullOrEmpty(Model.Patient?.DOB))
                                    {
                                        DateTime dobDate;
                                        if (DateTime.TryParse(Model.Patient.DOB, out dobDate))
                                        {
                                            dobValue = dobDate.ToString("dd/MM/yyyy");
                                        }
                                        else
                                        {
                                            dobValue = Model.Patient.DOB;
                                        }
                                    }
                                }
                                <input type="text" class="form-control js-date-picker" name="DOB" value="@dobValue" placeholder="MM/DD/YYYY" />
                                <span class="text-danger" asp-validation-for="DOB"></span>
                            </div>
                        </div>


                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Gender</label>
                                <select class="form-control js-select2" name="Gender">
                                    <option value="">Select Gender</option>
                                    <option value="Male" @(Model.Patient?.Gender == "Male" ? "selected" : "")>Male</option>
                                    <option value="Female" @(Model.Patient?.Gender == "Female" ? "selected" : "")>Female</option>
                                    <option value="Other" @(Model.Patient?.Gender == "Other" ? "selected" : "")>Other</option>
                                </select>

                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>CNIC</label>
                                <input type="text" class="form-control" name="CNIC" placeholder="XXXXX-XXXXXXX-X" pattern="[0-9]{5}-[0-9]{7}-[0-9]{1}" title="CNIC format: 12345-1234567-1" />

                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>City</label><br />
                                <select class="form-control js-form-city js-select2" name="City">
                                    <option value="">Select City</option>
                                    @foreach (var city in Model.Cities)
                                    {
                                        <option value="@city">@city</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-12 col-sm-12">
                            <div class="form-group">
                                <label>Residential Address</label><br />
                                <input type="text" class="form-control" name="Address" placeholder="eg: Block 5, street 7..." />
                            </div>
                        </div>
                        @*<div class="col-md-6 col-sm-12">
                                <div class="form-group">
                                    <label>MR Number</label><br />
                                    <input type="text" class="form-control" name="MR_No" placeholder="eg: 001" />
                                </div>
                            </div>*@
                        <input type="hidden" name="ID" value="0" />
                        @*<input type="hidden" name="CreatedBy" value="@username" required />
                            <input type="hidden" name="LastModifiedBy" value="@username" required />
                            <input type="hidden" name="LocationID" value="@user.LocationID" required />
                            <input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary-custom js-save-btn">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Referral Contact Modal -->
