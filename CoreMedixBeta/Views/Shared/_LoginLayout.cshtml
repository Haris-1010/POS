<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - Pharmacy Login</title>
    @{
        string printLogo = CoreMedixBeta.Repositories.BrandingsRepository.GetPrintLogoUrl();
    }
    @if (!string.IsNullOrWhiteSpace(printLogo))
    {
        <link rel="icon" type="image/png" href="@printLogo" />
        <link rel="shortcut icon" type="image/png" href="@printLogo" />
    }
    else
    {
        <link rel="icon" href="~/favicon.ico" />
    }
    <script>
        (function () {
            try {
                // Login page always stays light
                document.documentElement.setAttribute('data-theme', 'light');
            } catch (e) { }
        })();
    </script>
    <link href="~/assets/Fonts/font.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/AdminLTE/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/assets/AdminLTE/dist/css/adminlte.min.css">
    <link href="~/ReplacementPaths/Toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/Styles/Shared/layout.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body.login-page {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            background: linear-gradient(135deg, #eef1fb 0%, #e3e8fb 35%, #dfe6ff 65%, #f4f6ff 100%);
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            position: relative;
            padding: 30px 16px;
            overflow-x: hidden;
            overflow-y: auto;
        }

        @@keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Floating particles */
        body.login-page::before,
        body.login-page::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: rgba(9,6,80,0.04);
            animation: float 20s infinite ease-in-out;
        }
        body.login-page::before {
            width: 600px; height: 600px;
            top: -200px; right: -100px;
        }
        body.login-page::after {
            width: 400px; height: 400px;
            bottom: -150px; left: -100px;
            animation-delay: -10s;
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(5deg); }
        }

        /* Login container */
        .login-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 540px;
            padding: 20px;
            margin: auto;
        }

        /* Card */
        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(9,6,80,0.12), 0 0 30px rgba(9,6,80,0.06);
            overflow: hidden;
            animation: slideUp 0.6s ease-out;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Header section */
        .login-header {
            background: linear-gradient(135deg, #eef1ff, #dfe6ff);
            padding: 30px 30px 25px;
            text-align: center;
            position: relative;
            overflow: hidden;
            border-bottom: 1px solid #e5e9fb;
        }

       /* .login-header::after {
            content: '';
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.95);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }*/

        .login-icon {
            width: 60px;
            height: 60px;
            background: rgba(9,6,80,0.08);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
            border: 2px solid rgba(9,6,80,0.15);
        }

        .login-icon i {
            font-size: 28px;
            color: var(--cm-accent-ink);
        }

        .login-header h1 {
            color: var(--cm-accent-ink);
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 4px;
            letter-spacing: 0.5px;
        }

        .login-header p {
            color: #5d6474;
            font-size: 13px;
            font-weight: 400;
        }

        /* Body */
        .login-body {
            padding: 35px 30px 30px;
        }

        .login-subtitle {
            text-align: center;
            color: #666;
            font-size: 13px;
            margin-bottom: 22px;
        }

        .login-label-ico {
            margin-right: 4px;
            width: 14px;
            color: var(--cm-accent-ink);
        }

        .login-body .form-group {
            margin-bottom: 20px;
        }

        .login-body label {
            font-size: 13px;
            font-weight: 600;
            color: #333;
            margin-bottom: 6px;
            display: block;
        }

        .input-group {
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            border: 1.5px solid #e0e0e0;
            transition: all 0.3s ease;
            /* layout.css forces a navy background on .input-group - keep it white here */
            background-color: #fff !important;
        }

        .input-group:focus-within {
            border-color: var(--cm-accent-ink);
            box-shadow: 0 2px 12px rgba(9,6,80,0.15);
        }

        .input-group .form-control {
            border: none;
            padding: 12px 15px;
            font-size: 14px;
            background: transparent;
            background-color: #fff !important;
            height: 48px;
            color: #212529;
        }

        .input-group .form-control:focus {
            box-shadow: none;
            border: none;
        }

        .input-group .input-group-append .input-group-text,
        .input-group .input-group-text {
            border: none;
            background-color: #fff !important;
            padding: 0 15px;
            color: var(--cm-accent-ink);
            font-size: 16px;
            cursor: default;
        }

        .btn-toggle-pass {
            background-color: #fff !important;
            border: none;
            color: var(--cm-accent-ink);
            padding: 0 15px;
            font-size: 15px;
            cursor: pointer;
            outline: none;
            transition: color .2s ease;
        }

            .btn-toggle-pass:hover,
            .btn-toggle-pass:focus {
                color: #2d1fa0;
                background-color: #fff !important;
                box-shadow: none;
            }

        .input-group .form-control::placeholder {
            color: #aaa;
            font-weight: 400;
        }

        /* Login button */
        .btn-login {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, var(--cm-accent), #1a1080);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(9,6,80,0.18);
            margin-top: 5px;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(9,6,80,0.25);
            background: linear-gradient(135deg, #0a0760, #2d1fa0);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .btn-login:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

        /* Footer */
        .login-footer {
            text-align: center;
            padding: 15px 30px 20px;
            border-top: 1px solid #f0f0f0;
        }

        .login-footer p {
            color: #999;
            font-size: 12px;
        }

        /* Responsive */
        @@media (max-width: 480px) {
            .login-container { padding: 15px; }
            .login-card { border-radius: 15px; }
            .login-header { padding: 25px 20px 20px; }
            .login-body { padding: 30px 20px 25px; }
        }
    </style>
    <link href="~/Styles/Shared/theme.css" rel="stylesheet" />
</head>
<body class="login-page">
    @RenderBody()

    <script src="~/assets/AdminLTE/plugins/jquery/jquery.min.js"></script>
    <script src="~/assets/AdminLTE/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/AdminLTE/plugins/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/assets/AdminLTE/plugins/jquery-validation/additional-methods.min.js"></script>
    <script src="~/ReplacementPaths/Toastr/toastr.min.js"></script>
    @RenderSection("Scripts", false)
</body>
</html>
