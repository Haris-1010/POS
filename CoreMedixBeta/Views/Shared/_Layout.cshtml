    <!-- Logout Handler -->
    <script>
        $(document).on('click', '.js-logout-btn', function (e) {
            e.preventDefault();
            bootbox.confirm({
                message: "Are you sure you want to logout?",
                callback: function (result) {
                    if (result) {
                        $.ajax({
                            url: '@Url.Action("LogOut", "Account")',
                            type: 'POST',
                            data: {
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (response) {
                                if (response.Status) {
                                    toastr.success(response.Message);
                                    setTimeout(function () {
                                        window.location.href = response.Data.redirectUrl;
                                    }, 500);
                                }
                            },
                            error: function () {
                                window.location.href = '@Url.Action("Login", "Account")';
                            }
                        });
                    }
                }
            });
        });
    </script>

    <!-- Top menu: click ya hover se submenu + active page highlight -->
    <script>
        (function () {
            function alignSub($li) {
                var $sub = $li.children('.cm-submenu');
                if (!$sub.length) return;
                $sub.css({ left: 0, right: 'auto' });
                var rect = $sub[0].getBoundingClientRect();
                if (rect.right > window.innerWidth - 8) {
                    $sub.css({ left: 'auto', right: 0 });
                }
            }

            // Click se submenu toggle
            $(document).on('click', '.cm-has-sub > .cm-menu-link', function (e) {
                e.preventDefault();
                var $li = $(this).parent('.cm-has-sub');
                $('.cm-has-sub').not($li).removeClass('cm-open');
                alignSub($li);
                $li.toggleClass('cm-open');
            });

            // Hover par submenu viewport ke andar align
            $(document).on('mouseenter', '.cm-has-sub', function () {
                alignSub($(this));
            });

            // Bahar click karne par band
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.cm-has-sub').length) {
                    $('.cm-has-sub').removeClass('cm-open');
                }
            });

            $(document).on('keydown', function (e) {
                if (e.key === 'Escape') $('.cm-has-sub').removeClass('cm-open');
            });

            // Current page ka menu highlight
            $(function () {
                var path = window.location.pathname.toLowerCase();

                function isActive(href) {
                    if (!href || href === '#' || href.indexOf('javascript:') === 0) return false;
                    if (href === path) return true;
                    if (path.indexOf(href + '/') === 0) return true;
                    if (href.indexOf(path + '/') === 0) return true;
                    return false;
                }

                $('.cm-submenu-link').each(function () {
                    var href = ($(this).attr('href') || '').split('?')[0].toLowerCase();
                    if (isActive(href)) {
                        $(this).addClass('active');
                        $(this).closest('.cm-has-sub').addClass('is-active');
                    }
                });

                $('.cm-topnav-menu > .cm-menu-item > .cm-menu-link').each(function () {
                    var href = ($(this).attr('href') || '').split('?')[0].toLowerCase();
                    if (isActive(href)) {
                        $(this).closest('.cm-menu-item').addClass('is-active');
                    }
                });
            });
        })();
    </script>

