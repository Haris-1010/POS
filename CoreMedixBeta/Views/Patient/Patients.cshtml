@model CoreMedixBeta.Models.Patient.PatientVM@using CoreMedixBeta.Models.Patient@{
    ViewBag.Title = "Customers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}@section Styles{    <link href="~/panel-assets/plugins/bootstrap-datepicker/bootstrap-datepicker.min.css" rel="stylesheet" />    <style>        select[name="customersTable_length"] {            margin-top: -4px !important;        }    </style>}<div class="card">    <div class="card-header d-flex justify-content-between">                <div class="card-title font-weight-bold primary-text mt-2">
            Customers
        </div>
        <div class="ml-auto">

            <button class="btn btn-primary-custom text-left" id="addCustomerBtn" data-target="#saveCustomerModal" data-toggle="modal" data-backdrop="static" data-keyboard="false">
                <i class="fas fa-plus"></i> Add Customer
            </button>
        </div>    </div>    <div class="card-body">        <table class="table table-hover w-100 table-responsive-sm" id="customersTable">            <thead>                <tr>                    <th>Customer ID</th>                    <th>Name</th>                    <th>Phone</th>                    <th>CNIC</th>                    <th>City</th>                    <th>Residential Address</th>                    <th>Date of Birth</th>                    <th>Gender</th>                    <th>Actions</th>                </tr>            </thead>            <tbody>            </tbody>        </table>    </div></div><div class="modal fade" id="saveCustomerModal">    <div class="modal-dialog">        <div class="modal-content">            <div class="modal-header">                <h5 class="modal-title primary-text font-weight-bold ">Save Customer</h5>                <button type="button" class="close" data-dismiss="modal" aria-label="Close">                    <span aria-hidden="true">&times;</span>                </button>            </div>            <div class="modal-body">                <form>                    <div class="row">                        <div class="col-md-6 col-sm-12">                            <div class="form-group">                                <label>Name<span class="required">*</span></label>                                                                <input type="text" class="form-control" name="Name" required maxlength="@Patients.MaxNameLength" placeholder="Enter customer name" />
                            </div>                        </div>                        <div class="col-md-6 col-sm-12">                            <div class="form-group">                                                                <label>Phone</label>
                                <input type="number" class="form-control" name="Phone" maxlength="@Patients.MaxPhoneLength" placeholder="e.g 03xxxxxxxxx" />
                            </div>                        </div>                        <div class="col-md-6 col-sm-12">                            <div class="form-group">                                                                <label>Date of Birth</label>
                                <input type="hidden" name="DOBInCaseOfUpdate" value="@(Model.Patient?.DOB)" />                                @{                                    string dobValue = "";                                    if (!string.IsNullOrEmpty(Model.Patient?.DOB))                                    {                                        DateTime dobDate;                                        if (DateTime.TryParse(Model.Patient.DOB, out dobDate))                                        {                                            dobValue = dobDate.ToString("dd/MM/yyyy");                                        }                                        else                                        {                                            dobValue = Model.Patient.DOB;                                        }                                    }                                }                                                                <input type="text" class="form-control js-date-picker" name="DOB" value="@dobValue" placeholder="MM/DD/YYYY" />
                                <span class="text-danger" asp-validation-for="DOB"></span>                            </div>                        </div>                        <div class="col-md-6 col-sm-12">                            <div class="form-group">                                                                <label>Gender</label>
                                <select class="form-control js-select2" name="Gender">
                                    <option value="">Select Gender</option>                                    <option value="Male" @(Model.Patient?.Gender == "Male" ? "selected" : "")>Male</option>                                    <option value="Female" @(Model.Patient?.Gender == "Female" ? "selected" : "")>Female</option>                                    <option value="Other" @(Model.Patient?.Gender == "Other" ? "selected" : "")>Other</option>                                </select>                            </div>                        </div>                        <div class="col-md-6 col-sm-12">                            <div class="form-group">                                <label>CNIC</label>                                <input type="text" class="form-control" name="CNIC" placeholder="XXXXX-XXXXXXX-X" pattern="[0-9]{5}-[0-9]{7}-[0-9]{1}" title="CNIC format: 12345-1234567-1" />                            </div>                        </div>                        <div class="col-md-6 col-sm-12">                            <div class="form-group">                                                                <label>City</label><br />
                                <select class="form-control js-form-city js-select2" name="City">
                                    <option value="">Select City</option>                                    @foreach (var city in Model.Cities)                                    {                        <option value="@city">@city</option>                    }                                </select>                            </div>                        </div>                        <div class="col-md-12 col-sm-12">                            <div class="form-group">                                <label>Residential Address</label><br />                                <input type="text" class="form-control" name="Address" placeholder="eg: Block 5, street 7..." />                            </div>                        </div>                        @*<div class="col-md-6 col-sm-12">                                <div class="form-group">                                    <label>MR Number</label><br />                                    <input type="text" class="form-control" name="MR_No" placeholder="eg: 001" />                                </div>                            </div>*@                        <input type="hidden" name="ID" value="0" />                        @*<input type="hidden" name="CreatedBy" value="@username" required />                            <input type="hidden" name="LastModifiedBy" value="@username" required />                            <input type="hidden" name="LocationID" value="@user.LocationID" required />                            <input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@                    </div>                </form>            </div>            <div class="modal-footer">                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>                <button type="button" class="btn btn-primary-custom js-save-btn">Save</button>            </div>        </div>    </div></div>@section Scripts{    <script>    var getCustomersUrl = '@Url.Action("GetAllCustomersPagedList", "Patient")';    var saveCustomerUrl = '@Url.Action("SavePatients", "Patient")';    var deleteCustomerUrl = '@Url.Action("DeleteCustomer", "Patient")';    </script>    <script src="~/panel-assets/plugins/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>    <script src="~/panel-assets/plugins/DateRange/moment.min.js"></script>    <script src="~/JSModels/Patients/Patient.js"></script>}