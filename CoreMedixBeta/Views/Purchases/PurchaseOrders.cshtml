@{
    ViewBag.Title = "PurchaseOrders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model CoreMedixBeta.Models.PurchaseOrders.PurchaseOrdersVM

@section Styles
{
    <link href="~/panel-assets/plugins/DateRange/daterangepicker.css" rel="stylesheet" />
    <style>
        th, td {
            padding-left: 5px !important;
        }

        #purchaseOrderCards .filter-card {
            cursor: pointer;
        }
        select[name="ordersTable_length"] {
            margin-top: -4px !important;
        }
    </style>
}

<div id="purchaseOrderCards" class="row mb-3">
    <div class="col-lg-3 col-6">
        <div class="info-box filter-card" data-filter="PendingOrders">
            <span class="info-box-icon bg-warning"><i class="fas fa-hourglass-half"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Pending Orders</span>
                <span class="info-box-number js-pending-orders">0</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="info-box filter-card" data-filter="Ordered">
            <span class="info-box-icon bg-success"><i class="fas fa-check"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Ordered</span>
                <span class="info-box-number js-ordered">0</span>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="info-box filter-card" data-filter="ReceivedOrders">
            <span class="info-box-icon bg-primary"><i class="fas fa-truck"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Received Orders</span>
                <span class="info-box-number js-received-orders">0</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="info-box filter-card" data-filter="All">
            <span class="info-box-icon bg-info"><i class="fas fa-file-alt"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Total Orders</span>
                <span class="info-box-number js-total-order">0</span>
            </div>
        </div>
    </div>
</div>
