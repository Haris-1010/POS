<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-filter"></i> Purchase Orders Filters</h3>
        <div class="card-tools">
            <button class="btn btn-tool js-toggle-btn" type="button" data-toggle="collapse" data-target="#filterCard" aria-expanded="false" aria-controls="filterCard">
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
    <form id="filterForm">
        <div id="filterCard" class="collapse">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Date Range</label>
                            <input type="text" class="form-control" name="Date" placeholder="Select date range">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Supplier</label>
                            <select class="form-control js-select2" name="SupplierID">
                                <option value="">Choose Supplier</option>
                                @if (Model.SuppliersShortList != null && Model.SuppliersShortList.Count > 0)
                                {
                                    foreach (var Supplier in Model.SuppliersShortList)
                                    {
                                        <option value="@Supplier.ID">@Supplier.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Reference No</label>
                            <input class="form-control" placeholder="Reference No" name="ReferenceNo" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Purchase Status</label>
                            <select class="form-control js-select2" name="Status">
                                <option value="">All</option>
                                <option value="Pending">Pending</option>
                                <option value="Received">Received</option>
                                <option value="Ordered">Ordered</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Sort By</label>
                                    <select class="form-control js-select2" name="SortBy">
                                        <option value="ID" selected>Latest</option>
                                        <option value="Date">Date</option>
                                        <option value="SuplierName">Supplier</option>
                                        <option value="Status">Status</option>
                                        <option value="TotalItems">No of Items</option>
                                        <option value="SubTotal">Sub Total</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 pl-0">
                                <div class="form-group">
                                    <label>Order</label>
                                    <select class="form-control js-select2" name="SortByOrder">
                                        <option value="ASC" selected>Ascending</option>
                                        <option value="DESC">Descending</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3 ml-auto">
                        <div class="form-group mb-0 d-flex justify-content-between">
                            <label></label>
                            <button type="button" class="btn btn-primary-custom form-control text-nowrap js-apply-filter-btn">Apply Filter</button>
                            <button type="button" class="btn btn-default form-control js-clear-filter-btn ml-2">Clear Filter</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <input type="hidden" value="@Model.CurrencySymbol" class="form-control" id="currency">
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-file-invoice"></i> Purchase Orders</h3>

        <div class="card-tools">
            <a href='@Url.Action("ManagePurchaseOrder", "Purchases")' class="btn btn-primary-custom">
                <i class="fa fa-plus"></i> New Purchase Order
            </a>

        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="ordersTable" class="table table-striped table-hover w-100">
                <thead>
                    <tr>
                        <th>Reference No</th>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th>Status</th>
                        <th>No Of Items</th>
                        <th>Sub Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="saveClearDueModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title primary-text font-weight-bold ">Clear Due</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Paid Amount</label>
                                <input type="number" class="form-control" name="PaidAmount" placeholder="Enter amount" min="0" readonly="">
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Due Amount <span class="required">*</span></label>
                                <input type="number" class="form-control" name="RemainingAmount">
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Date <span class="required">*</span></label>
                                <input type="text" class="form-control js-datepicker" name="Date" placeholder="Enter date" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Mode <span class="required">*</span></label>
                                <select class="form-control" name="PaymentMode">
                                    <option value="Cash" selected)>Cash</option>
                                    <option value="JazzCash">JazzCash</option>
                                    <option value="EasyPaisa">EasyPaisa</option>
                                    <option value="Card">Card</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    @*<input type="hidden" name="LastModifiedBy" value="@user.Username" required />*@
                    <input type="hidden" name="AttachmentURL" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary-custom js-clearDue-save-btn">Save</button>
            </div>
        </div>
    </div>
</div>

