                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="form-group">
                        <label>Business Phone<span class="required">*</span></label>
                        <input type="number" class="form-control" name="BusinessPhone" required maxlength="13" minlength="11" placeholder="e.g 03xxxxxxxxx" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" class="form-control" name="BusinessEmail" placeholder="example@gmail.com" />
                    </div>
                </div>
                <div class="col-md-6 col-sm-12">
                    <div class="form-group">
                        <label>Header Text</label><br />
                        <input type="text" class="form-control" name="HeaderText" placeholder="eg: InstaCare is the No.1 Healthcare Company" />
                    </div>
                </div>
                <div class="col-md-6 col-sm-12">
                    <div class="form-group">
                        <label>Footer Text</label><br />
                        <input type="text" class="form-control" name="FooterText" placeholder="eg: Visit our website instacare.pk" />
                    </div>
                </div>
