<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class=""></i> Dynamic Print Fields</h3>
        <div class="card-tools">
            <button class="btn btn-tool" type="button" data-toggle="collapse" data-target="#fieldCard" aria-expanded="false" aria-controls="fieldCard">
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
    <div id="fieldCard" class="card-header collapse">

        <div class="card-tools">
            <button class="btn btn-primary-custom text-left" id="newFieldBtn" data-target="#saveFieldModal" data-backdrop="static" data-keyboard="false">
                <i class="fa fa-plus"></i> New Filed
            </button>
        </div>

        <div class="card-body">
            <table class="table table-hover w-100 table-responsive-sm" id="fieldsTable">
                <thead>
                    <tr>
                        <th>Field Name</th>
                        <th>Field Value</th>
                        <th>For Module</th>
                        <th>Field Order</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="saveFieldModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title primary-text font-weight-bold ">Save Field</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Title<span class="required">*</span></label>
                                <input type="text" class="form-control" name="FieldName" required maxlength="55" minlength="3" placeholder="Enter field name" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Value<span class="required">*</span></label>
                                <input type="text" class="form-control" name="FieldValue" required maxlength="100" minlength="3" placeholder="Enter field name" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Field order<span class="required">*</span></label>
                                <input type="number" class="form-control" name="Order" required max="10" min="0" placeholder="Field order" />
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group">
                                <label class="invisible">Is Visible</label>
                                <div class="checkbox-wrapper">
                                    <input id="InVisible" name="InVisible" type="checkbox" class="switch" checked>
                                    <label for="InVisible">Is Visible</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Select module<span class="required">*</span></label><br />
                                <select class="form-control js-form-city" required name="ForModule">
                                    <option value="">For Module</option>
                                    @*@foreach (var city in Model.Cities)
                                        {*@
                                    <option value="Sale">Sale</option>
                                    <option value="Purchase">Purchase</option>
                                    @*}*@
                                </select>
                            </div>
                        </div>
                        <input type="hidden" name="ID" value="0" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary-custom js-save-btn">Save</button>
            </div>
        </div>
    </div>
</div>
