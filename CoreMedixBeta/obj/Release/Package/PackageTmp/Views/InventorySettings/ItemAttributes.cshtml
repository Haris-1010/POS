        <input type="hidden" name="canUpdate" value="@(user.IsAdmin || user.Permissions.Any(x => x.Discriminator == Constants.PharmacyPermDisc && x.Name == PharmacyUserPermissions.Settings.ItemAttributesUpdate && x.IsGranted) ? "1" : "0")" />
        <input type="hidden" name="canDelete" value="@(user.IsAdmin || user.Permissions.Any(x => x.Discriminator == Constants.PharmacyPermDisc && x.Name == PharmacyUserPermissions.Settings.ItemAttributesDelete && x.IsGranted) ? "1" : "0")" />
    </form>*@
@section Scripts{
    <script> 
        var SaveItemAttributeUrl = '@Url.Action("SaveItemAttribute", "InventorySettings")';
        var GetItemAttributesUrl = '@Url.Action("GetItemAttributes", "InventorySettings")';
        var DeleteItemAttributeUrl = '@Url.Action("DeleteItemAttribute", "InventorySettings")';
    </script>
    <script src="~/JSModels/InventorySettings/itemAttributes.js"></script>
}
