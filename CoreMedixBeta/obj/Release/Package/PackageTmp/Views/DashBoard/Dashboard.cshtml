@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model CoreMedixBeta.Models.DashBoard.DashBoardVM
@{
    bool isUpdate = Model.DashboardSettings != null && Model.DashboardSettings.Count > 0;
    var DashBoardCards = new[]
    {
        new { Title = "Today’s Sales", CardID = 1 },
        new { Title = "Total Invoices", CardID = 2 },
        new { Title = "Today’s Profit", CardID = 3 },
        new { Title = "Total Patients Today", CardID = 4 },
        new { Title = "Stock Value", CardID = 5 },
        new { Title = "Expiring Soon", CardID = 6 },
        new { Title = "Today’s Stock Sold Value", CardID = 7 }
    };
}

@section styles{
    <style>
        @@supports (-webkit-appearance: none) or (-moz-appearance: none) {
            .checkbox-wrapper input[type=checkbox] {
                --active: #090650;
                --active-inner: #fff;
                --focus: 2px rgba(39, 94, 254, .3);
                --border: #BBC1E1;
                --border-hover: #BBC1E1;
                --background: #fff;
                --disabled: #F6F8FF;
                --disabled-inner: #E1E6F9;
                -webkit-appearance: none;
                -moz-appearance: none;
                height: 21px;
                outline: none;
                display: inline-block;
                vertical-align: top;
                position: relative;
                margin: 0;
                cursor: pointer;
                border: 1px solid var(--bc, var(--border));
                background: var(--b, var(--background));
                transition: background 0.3s, border-color 0.3s, box-shadow 0.2s;
            }

                .checkbox-wrapper input[type=checkbox]:after {
                    content: "";
                    display: block;
                    left: 0;
                    top: 0;
                    position: absolute;
                    transition: transform var(--d-t, 0.3s) var(--d-t-e, ease), opacity var(--d-o, 0.2s);
                }

                .checkbox-wrapper input[type=checkbox]:checked {
                    --b: var(--active);
                    --bc: var(--active);
                    --d-o: .3s;
                    --d-t: .6s;
                    --d-t-e: cubic-bezier(.2, .85, .32, 1.2);
                }

                .checkbox-wrapper input[type=checkbox]:disabled {
                    --b: var(--disabled);
                    cursor: not-allowed;
                    opacity: 0.9;
                }

                    .checkbox-wrapper input[type=checkbox]:disabled:checked {
                        --b: var(--disabled-inner);
                        --bc: var(--border);
                    }

                    .checkbox-wrapper input[type=checkbox]:disabled + label {
                        cursor: not-allowed;
                    }

                .checkbox-wrapper input[type=checkbox]:hover:not(:checked):not(:disabled) {
                    --bc: var(--border-hover);
                }

                .checkbox-wrapper input[type=checkbox]:focus {
                    box-shadow: 0 0 0 var(--focus);
                }

                .checkbox-wrapper input[type=checkbox]:not(.switch) {
                    width: 21px;
                }

                    .checkbox-wrapper input[type=checkbox]:not(.switch):after {
                        opacity: var(--o, 0);
                    }

                    .checkbox-wrapper input[type=checkbox]:not(.switch):checked {
                        --o: 1;
                    }

                .checkbox-wrapper input[type=checkbox] + label {
                    display: inline-block;
                    vertical-align: middle;
                    cursor: pointer;
                    margin-left: 4px;
                }

                .checkbox-wrapper input[type=checkbox]:not(.switch) {
                    border-radius: 7px;
                }

                    .checkbox-wrapper input[type=checkbox]:not(.switch):after {
                        width: 5px;
                        height: 9px;
                        border: 2px solid var(--active-inner);
                        border-top: 0;
                        border-left: 0;
                        left: 7px;
                        top: 4px;
                        transform: rotate(var(--r, 20deg));
                    }

                    .checkbox-wrapper input[type=checkbox]:not(.switch):checked {
                        --r: 43deg;
                    }

                .checkbox-wrapper input[type=checkbox].switch {
                    width: 28px;
                    height: 16px;
                    border-radius: 8px;
                }

                    .checkbox-wrapper input[type=checkbox].switch:after {
                        left: 2px;
                        top: 2px;
                        border-radius: 50%;
                        width: 12px;
                        height: 12px;
                        background: var(--ab, var(--border));
                        transform: translateX(var(--x, 0));
                    }

                    .checkbox-wrapper input[type=checkbox].switch:checked {
                        --ab: var(--active-inner);
                        --x: 12px;
                    }

                    .checkbox-wrapper input[type=checkbox].switch:disabled:not(:checked):after {
                        opacity: 0.6;
                    }
        }

        .checkbox-wrapper * {
            box-sizing: inherit;
        }

            .checkbox-wrapper *:before,
            .checkbox-wrapper *:after {
                box-sizing: inherit;
            }

        table#dashboardSettingsTable td, th {
            border-top: 0px;
            font-size: small;
            padding-top: 5px;
            padding-bottom: 5px;
        }

        .p-3.control-sidebar-content {
            padding: 0rem !important;
        }
    </style>
}
<div>
    <div class="text-right mb-2">
        <button class="btn btn-default btn-sm" data-widget="control-sidebar" data-controlsidebar-slide="true">
            <i class="nav-icon fas fa-cog"></i>
        </button>
    </div>

    @* Dashboard Cards *@
    <div class="row">
        @foreach (var card in Model.DashBoardCards)
        {
            <div class="col-lg-4 col-6">
                <div class="small-box @card.BgColor card-clickable"
                     data-card-id="@card.CardID"
                     data-card-title="@card.Title">
                    <div class="inner">
                        <h3>@if (card.Title == "Today’s Sales" || card.Title == "Stock Value" || card.Title == "Today’s Profit"|| card.Title == "Today’s Stock Sold Value")
                        {<span>Rs.</span>}  @card.Value</h3>
                        <p>@card.Title</p>
                    </div>
                    <div class="icon">
                        <i class="@card.Icon"></i>
                    </div>
                </div>
            </div>
        }
    </div>


    @* Sidebar options cards and graphs configuration *@
    <aside class="control-sidebar control-sidebar-light" style="display: none;">

        <button type="button" class="close float-left mb-2 js-close-sidebar btn-default" aria-label="Close" style="font-size: 24px;border: none;background: darkgrey;border-radius: 20px;padding: 0px 5px 0px 5px;margin-left: -13px;">
            ×
        </button>

        <div class="p-3 control-sidebar-content">
            <h5 class="text-center pt-3">Dashboard Setting</h5>
            <hr class="mb-2">
            <h6 class="ml-2">Cards Options</h6>

            <!-- Add your card setting controls here -->
            <table class="table" id="dashboardSettingsTable">
                <tbody>
                    @if (isUpdate)
                    {
                        foreach (var card in Model.DashboardSettings)
                        {
                            <tr>
                                <td>@card.Title</td>
                                <td>
                                    <div class="checkbox-wrapper">
                                        <input class="switch pull-right" type="checkbox" name="IsVisible" checked="@card.IsVisible" />
                                    </div>
                                </td>
                                <td>
                                    <input type="hidden" name="Title" value="@card.Title" />
                                    <input type="hidden" name="CardID" value="@card.CardID" />
                                    <input type="hidden" name="Order" value="@card.Order" />
                                    <input type="hidden" name="ID" value="@card.ID" />
                                    @*<input type="hidden" name="UserID" value="@user.Username" />
                                        <input type="hidden" name="LocationID" value="@user.LocationID" required />
                                        <input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        foreach (var card in DashBoardCards)
                        {
                            <tr>
                                <td>@card.Title</td>
                                <td>
                                    <div class="checkbox-wrapper">
                                        <input class="switch pull-right" type="checkbox" name="IsVisible" checked />
                                    </div>
                                </td>
                                <td>
                                    <input type="hidden" name="Title" value="@card.Title" />
                                    <input type="hidden" name="CardID" value="@card.CardID" />
                                    <input type="hidden" name="Order" value="0" />
                                    <input type="hidden" name="ID" value="0" />
                                    @*<input type="hidden" name="UserID" value="@user.Username" />
                                        <input type="hidden" name="LocationID" value="@user.LocationID" required />
                                        <input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div style="margin: 0px 60px; display: flex; justify-content: center;">
                <button type="submit" class="btn btn-block btn-primary btn-sm js-save-btn">Update Settings</button>
            </div>
        </div>
    </aside>
</div>

@section Scripts{
    <script>

        var SaveDashBoardSettingUrl = '@Url.Action("SaveDashBoardSetting", "DashBoard")';
            var reportSaleUrl = '@Url.Action("SaleReport", "Reports")';
    var saleInvoicesUrl = '@Url.Action("SaleInvoices", "Sales")';
    var profitMarginReportUrl = '@Url.Action("ProfitMarginReport", "Reports")';
    var dailySalesReportUrl = '@Url.Action("DailySalesReport", "Reports")';
    var stockValuationReportUrl = '@Url.Action("StockValuationReport", "Reports")';
    var inventoryItemsUrl = '@Url.Action("Items", "InventoryItems")';

    </script>
    <script src="~/JSModels/DashBoard/dashBoardSetting.js"></script>
}