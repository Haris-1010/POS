@model CoreMedixBeta.Models.ManufacturerBrand.BrandViewModel
@{
    ViewBag.Title = "Brand";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style>
        .action-btns {
            display: flex;
            gap: 5px;
        }
    </style>
}
<input type="hidden" id="manufacturerID" value="@Model.ManufacturerID">
<div class="card">
    <div class="card-header d-flex justify-content-between">
        <div class="card-title font-weight-bold primary-text mt-2">
            Brands
        </div>
        <div class="ml-auto">
            <button class="btn btn-primary-custom text-left" id="addBrandBtn" data-target="#BrandModal" data-toggle="modal" data-backdrop="static" data-keyboard="false">
                <i class="fas fa-plus"></i> Add Brand
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-hover w-100 table-responsive-sm" id="brandTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="BrandModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title primary-text font-weight-bold ">Save Brand</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-md-12 col-sm-12">
                            <div class="form-group">
                                <label>Title<span class="required">*</span></label>
                                <input type="text" class="form-control" name="Title" required placeholder="Enter Title" />
                            </div>
                        </div>
                        <input type="hidden" name="ID" value="0" />
                        <input type="hidden" name="ManufacturerID" value="@Model.ManufacturerID" />
                        @*<input type="hidden" name="CreatedBy" value="@username" required />
                            <input type="hidden" name="LastModifiedBy" value="@username" required />
                            <input type="hidden" name="LocationID" value="@user.LocationID" required />
                            <input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary-custom js-save-btn">Save</button>
            </div>
        </div>
    </div>
</div>

