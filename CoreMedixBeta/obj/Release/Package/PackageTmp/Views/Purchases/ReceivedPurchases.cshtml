
@model CoreMedixBeta.Models.PurchaseOrders.PurchaseOrdersVM
@{
    ViewBag.Title = "ReceivedPurchases";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles
{
    <link href="~/panel-assets/plugins/DateRange/daterangepicker.css" rel="stylesheet" />
    <style>
        th, td {
            padding-left: 5px !important;
        }

        select[name="purchasesTable_length"] {
            margin-top: -4px !important;
        }
    </style>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-filter"></i> Purchases Filters</h3>
        <div class="card-tools">
            <button class="btn btn-tool js-toggle-btn" type="button" data-toggle="collapse" data-target="#filterCard" aria-expanded="false" aria-controls="filterCard">
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
    <form id="filterForm">
        <div id="filterCard" class="collapse">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Date Range</label>
                            <input type="text" class="form-control" name="Date" placeholder="Select date range">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Supplier</label>
                            <select class="form-control js-select2" name="SupplierID">
                                <option value="">Choose Supplier</option>
                                @if (Model.SuppliersShortList != null && Model.SuppliersShortList.Count > 0)
                                {
                                    foreach (var Supplier in Model.SuppliersShortList)
                                    {
                                        <option value="@Supplier.ID">@Supplier.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Reference No</label>
                            <input class="form-control" placeholder="Reference No" name="ReferenceNo" />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Sort By</label>
                                    <select class="form-control js-select2" name="SortBy">
                                        <option value="ID" selected>Latest</option>
                                        <option value="PurchaseDate">Date</option>
                                        <option value="SuplierName">Supplier</option>
                                        <option value="SubTotalAfterTax">Net Total</option>
                                        <option value="PaidAmount">Paid Amount</option>
                                        <option value="RemainingAmount">Due Amount</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 pl-0">
                                <div class="form-group">
                                    <label>Order</label>
                                    <select class="form-control js-select2" name="SortByOrder">
                                        <option value="ASC" selected>Ascending</option>
                                        <option value="DESC">Descending</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3 ml-auto">
                        <div class="form-group mb-0 d-flex justify-content-between">
                            <label></label>
                            <button type="button" class="btn btn-primary-custom form-control text-nowrap js-apply-filter-btn">Apply Filter</button>
                            <button type="button" class="btn btn-default form-control js-clear-filter-btn ml-2">Clear Filter</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <input type="hidden" value="@Model.CurrencySymbol" class="form-control" id="currency">
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-file-invoice"></i> Received Purchases</h3>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="purchasesTable" class="table table-striped table-hover w-100">
                <thead>
                    <tr>
                        <th>Reference No</th>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th>Net Total</th>
                        <th>Paid Amount</th>
                        <th>Due Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
@section Scripts{
    <script> 
        var GetPagedPurchasesUrl = '@Url.Action("GetPagedPurchases", "Purchases")';
        var printPurchaseUrl = '@Url.Action("PrintPurchase", "Print")'; 
    </script>
    <script src="~/panel-assets/plugins/DateRange/moment.min.js"></script>
    <script src="~/panel-assets/plugins/DateRange/daterangepicker.js"></script>
    <script src="~/JSModels/PurchaseOrders/receivedPurchases.js"></script>
}
