        <input type="hidden" name="canCreate" value="@(user.IsAdmin || user.Permissions.Any(x => x.Discriminator == Constants.PharmacyPermDisc && x.Name == PharmacyUserPermissions.Supplier.Create && x.IsGranted) ? "1" : "0")" />
        <input type="hidden" name="canUpdate" value="@(user.IsAdmin || user.Permissions.Any(x => x.Discriminator == Constants.PharmacyPermDisc && x.Name == PharmacyUserPermissions.Supplier.Update && x.IsGranted) ? "1" : "0")" />
        <input type="hidden" name="canDelete" value="@(user.IsAdmin || user.Permissions.Any(x => x.Discriminator == Constants.PharmacyPermDisc && x.Name == PharmacyUserPermissions.Supplier.Delete && x.IsGranted) ? "1" : "0")" />
    </form>*@
@section Scripts{

    <script>
  var getSupplierUrl = '@Url.Action("GetPagedSuppliers", "Supplier")';
  var saveSupplierUrl = '@Url.Action("SaveSupplier", "Supplier")';
  var deleteSupplierUrl = '@Url.Action("DeleteSupplier", "Supplier")';
