@model CoreMedixBeta.Models.Sales.ManageInvoiceVM
@{
    ViewBag.Title = "ManageInvoiceReturn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Newtonsoft
@using CoreMedixBeta.Models.Sales
@using CoreMedixBeta.Models.Sales.DTOs
@using CoreMedixBeta.Models.ReferralContacts

@{
    SaleInvoiceDto SaleInvoice = Model != null && Model.Invoice != null ? Model.Invoice.SaleInvoice : null;
    SaleInvoiceFinancialDetail SaleInvoiceFinancialDetails = Model != null && Model.Invoice != null ? Model.Invoice.SaleInvoiceFinancialDetails : null;

    bool isUpdate = SaleInvoice != null && SaleInvoice.ID > 0;
}

@section Styles{
    <link href="~/panel-assets/plugins/bootstrap-datepicker/bootstrap-datepicker.min.css" rel="stylesheet" />
    <link href="~/CSSModels/Sales/ManageInvoice.css" rel="stylesheet" />
    <style>
        .error-message {
            color: red;
            font-weight: bold;
            margin-top: 10px;
        }
    </style>

}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Invoice Information</h3>
    </div>
    <form id="saleInfoForm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="">Invoice Number#</label>
                        <input class="form-control" name="InvoiceNo" placeholder="xxxxxx" value="@(isUpdate ? SaleInvoice.InvoiceNo : Model.InvoicePrefix)" readonly />
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="">Customer</label>
                        <input type="text" value="@(isUpdate ? SaleInvoice.CustomerName : string.Empty)" name="SearchCustomer" autocomplete="off" class="form-control js-search-customer" required placeholder="Eg: 03001234450" readonly />
                        <input type="hidden" name="CustomerID" value="@(isUpdate ? SaleInvoice.CustomerID : string.Empty)" required>
                        <input type="hidden" name="CustomerType" value="@(isUpdate ? SaleInvoice.CustomerType : string.Empty)" required>
                    </div>
                </div>
                @*<div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label for="">Referred By</label>
                            <input type="text" value="@(isUpdate ? SaleInvoice.ReferredByName : string.Empty)" name="SearchReferredBy" autocomplete="off" class="form-control js-search-referred-by" placeholder="Eg: Safi Ullah" readonly />
                            <input type="hidden" name="ReferredByID" value="@(isUpdate ? SaleInvoice.ReferredByID : string.Empty)">
                            <input type="hidden" name="ReferredByType" value="@(isUpdate ? SaleInvoice.ReferredByType : string.Empty)">
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label for="">Sale Person</label>
                            <input type="hidden" name="SalePersonUsername" value="@SaleInvoice.SalePersonUsername">
                            <select class="form-control js-select2" name="SalePerson" resource="" disabled>
                                <option value="">Choose Sales Person</option>
                            </select>
                        </div>
                    </div>*@
                @*<div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Referred By</label>
                            <select class="form-control js-select2 js-doctors" name="ReferredBy">
                                <option value="">Select Referred By</option>
                            </select>
                        </div>
                    </div>*@
                <div class="col-md-4 col-sm-6">
                    <div class="form-group">
                        <label for="">Invoice Date</label>
                        @if (isUpdate)
                        {
                            <input type="text" class="form-control js-date-picker" name="InvoiceDate" value="@(SaleInvoice.InvoiceDate.ToString("MM/dd/yyyy"))" required readonly />
                        }
                    </div>
                </div>
                @*<div class="col-md-6">
                    <div class="form-group">
                        <label for="">Remarks</label>
                        <textarea class="form-control" rows="1" name="Remarks" placeholder="Add remarks here..." readonly>@(isUpdate ? SaleInvoice.Remarks : string.Empty)</textarea>
                    </div>
                </div>*@
            </div>
        </div>
        <input type="hidden" name="ID" value="@(isUpdate ? SaleInvoice.ID : 0)" />
    </form>
</div>

<div class="card">
    <div class="card-header">
    </div>
    <div class="card-body">
        <div class="table-responsive w-100">
            <table class="table table-hover table-bordered table-striped w-100" id="saleItemsTable">
                <thead style="background-color:var(--cm-surface-alt)">
                    <tr>
                        <th class="cutom-th">Name</th>
                        <th class="cutom-th" style="width:7% !important">Sale Qty</th>
                        <th class="cutom-th" style="width:7% !important">Return Qty</th>
                        <th class="cutom-th" style="width:7% !important">Final Qty</th>
                        <th class="cutom-th" style="width:5% !important">Unit Price</th>
                        @*<th class="cutom-th">Discount Type</th>*@
                        <th class="cutom-th" style="width:10% !important">Discount</th>
                        <th class="cutom-th" title="Unit Price Inc Tax" style="width:6% !important">USP (Inc. Tax)</th>
                        <th class="cutom-th" style="width:15% !important">Line Total</th>
                        @*<th class="cutom-th" style="width:5% !important"></th>*@
                    </tr>
                </thead>
                <tbody>
                    @if (isUpdate)
                    {
                        if (Model.Invoice.SaleInvoiceItems != null && Model.Invoice.SaleInvoiceItems.Count > 0)
                        {
                            foreach (var item in Model.Invoice.SaleInvoiceItems)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>

                                        <input type="hidden" name="ItemID" value="@item.ItemID">
                                        <input type="hidden" name="VariationID" value="@item.VariationID">
                                        <input type="number" class="form-control" name="SaleQty" placeholder="Enter Quantity" value="@item.Qty" readonly>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control" name="ReturnQty" placeholder="Enter Qty To Return" value="0" min="0" max="@item.Qty">
                                    </td>
                                    <td>
                                        <input type="number" class="form-control" name="Qty" placeholder="Enter Qty To Return" value="@item.Qty" min="0" max="@item.Qty" readonly>
                                    </td>
                                    <td>@item.UnitCost</td>
                                    <td>
                                        <div class="d-flex border-0">
                                            <input type="hidden" name="DiscountID" value="@item.DiscountID" />
                                            <input type="hidden" name="DiscountType" value="@item.DiscountType" />
                                            <select class="form-control js-discount-list" disabled name="" data-rowindex="@item.ID" style="min-width:5rem !important; font-size:.8rem !important;">
                                                <option value="0" data-discount-type="select" data-discount-value="0" @(item.DiscountID == 0 ? "selected" : "")>Select Discount</option>
                                                @foreach (var discount in Model.Discounts)
                                                {
                                                    <option value="@discount.ID"
                                                            data-discount-type="@discount.DiscountType"
                                                            data-discount-value="@discount.DiscountValue"
                                                            @(item.DiscountID == discount.ID ? "selected" : "")>
                                                        @discount.DiscountName
                                                    </option>
                                                }
                                                <option value="0" data-discount-type="custom" data-discount-value="0" @(item.DiscountID == 0 && item.Discount > 0 ? "selected" : "")>Custom</option>
                                            </select>
                                            <select class="form-control js-discount-type" disabled name="DiscountType" data-rowindex="@item.ID" style="@(item.DiscountID == 0 && item.Discount > 0 ? "display:block;" : "display:none;") margin-inline:5px !important; min-width:5rem !important; font-size:.8rem !important;">
                                                <option value="value" @(item.DiscountType == "value" ? "selected" : "")>In Value</option>
                                                <option value="percentage" @(item.DiscountType == "percentage" ? "selected" : "")>Percentage</option>
                                            </select>
                                            <input type="number" class="form-control" readonly style="width:60%;@(item.DiscountID == 0 && item.Discount > 0 ? "display:block;" : "display:none;")" name="Discount" placeholder="Enter Discount" min="0" value="@item.Discount">
                                        </div>
                                    </td>
                                    <td>
                                        <input type="hidden" name="ItemTax" value="@item.ItemTax">
                                        <input type="text" class="form-control" style="width:100%" name="UnitCostWithTax" accept value="@item.UnitSalePriceInclusiveTax" readonly>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control" style="width:100%" name="LineTotal" value="@item.LineTotal" readonly>
                                        <input type="hidden" name="TransactionStatus" value="RETURNED" />
                                        <input type="hidden" name="RetQty" value="0" />
                                    </td>
                                    @*<td>
                                            <button class="btn btn-danger btn-sm tip js-remove-item-btn" title="Delete Item" type="button">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>*@
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="row">
            <div class="col-md-8 pr-5">
                <div class="card-header pl-0 pr-2">
                    <h3 class="card-title font-weight-bold">Payment Details</h3>
                    @if (Model.Invoice.SaleInvoicePayments != null && Model.Invoice.SaleInvoicePayments.Count > 0)
                    {
                        <div class="card-tools">
                            <button class="btn btn-primary-custom" id="returnPaymentBtn"><i class="fas fa-plus"></i>Add Return Payment</button>
                        </div>
                    }
                </div>
                <div class="card-body px-0">
                    <table class="table table-striped table-hover" id="paymentItemsTable">
                        <thead class="thead-light">
                            <tr>
                                <th style="width:20% !important">Date</th>
                                @if (Model.Invoice.SaleInvoicePayments != null && Model.Invoice.SaleInvoicePayments.Count > 0)
                                {
                                    <th style="width: 15% !important; white-space: nowrap;">
                                        Type
                                        <i class="fas fa-question-circle bg-white" data-bs-toggle="tooltip" title="It is Transaction Type which is payment or return"></i>
                                    </th>
                                }
                                <th style="width:15% !important">Amount</th>
                                <th style="width:20% !important">Mode</th>
                                <th style="width:20% !important">Attachement</th>
                                <th style="width:10% !important">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isUpdate)
                            {
                                if (Model.Invoice.SaleInvoicePayments != null && Model.Invoice.SaleInvoicePayments.Count > 0)
                                {
                                    foreach (var item in Model.Invoice.SaleInvoicePayments)
                                    {
                                        <tr>
                                            <td>
                                                <input type="text" class="form-control js-datepicker" value="@(item.Date)" name="Date" readonly />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@(item.TransactionType)" name="TransactionType" readonly />
                                            </td>
                                            <td>
                                                <input type="number" class="form-control" name="PaymentAmount" value="@item.PaidAmount" readonly />
                                            </td>
                                            <td>
                                                <select class="form-control js-select2" name="PaymentMode">
                                                    <option value="@item.PaymentMode" selected>@item.PaymentMode</option>
                                                </select>
                                                @*<input type="text" class="form-control" name="PaymentMode" value="@item.PaymentMode" readonly />*@
                                            </td>
                                            <td>
                                                <input type="file" class="form-control js-attachment" name="Attachment" />
                                                <input type="hidden" class="js-attachment-url" name="AttachmentURL" value="@item.AttachmentURL" />
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.AttachmentURL))
                                                {
                                                    <button class="btn btn-secondary text-white btn-sm tip js-view-img-btn"
                                                            title="View Image" type="button">
                                                        <i class="fa fa-eye"></i>
                                                    </button>
                                                }

                                                @*<button class="btn btn-danger btn-sm tip js-remove-payment-btn" title="Delete Payment" type="button">
                                                        <i class="fa fa-trash"></i>
                                                    </button>*@
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-4">
                <form id="saleCalculationsForm">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Subtotal</label>
                                <input type="number" name="SubTotal" value="@SaleInvoiceFinancialDetails.SubTotal" class="form-control" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="DiscountType">Discount Type</label>
                                <input type="hidden" name="DiscountType" id="InvoiceDiscountType" value="@SaleInvoiceFinancialDetails.DiscountType" />
                                <select class="form-control js-discount-type" name="" disabled>
                                    <option value="value" @(SaleInvoiceFinancialDetails.DiscountType == "value" ? "selected" : "")>Value</option>
                                    <option value="percentage" @(SaleInvoiceFinancialDetails.DiscountType == "percentage" ? "selected" : "")>Percentage</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Discount Amount</label><input type="hidden" id="OriginalDiscountAmount" value="@SaleInvoiceFinancialDetails.DiscountAmount" />
                                <input type="number" class="form-control" name="DiscountAmount" value="@SaleInvoiceFinancialDetails.DiscountAmount" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>SubtotalAfterDiscount</label>
                                <input type="number" class="form-control" name="SubtotalAfterDiscount" value="@SaleInvoiceFinancialDetails.SubtotalAfterDiscount" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Sales Tax</label>
                                <input type="hidden" name="TaxID" value="@SaleInvoiceFinancialDetails.TaxID" />
                                @{
                                    decimal selectedTax = 0;

                                    if (Model.Taxes != null)
                                    {
                                        foreach (var item in Model.Taxes)
                                        {
                                            if (item.ID == SaleInvoiceFinancialDetails.TaxID)
                                            {
                                                selectedTax = item.Percentage;
                                                break;
                                            }
                                        }
                                    }
                                }
                                <input type="hidden" name="TaxPercentage" value="@selectedTax" />

                                <select class="form-control js-select2" name="" disabled>
                                    <option value="0">Select Sales Tax</option>
                                    @if (Model.Taxes != null)
                                    {
                                        foreach (var item in Model.Taxes)
                                        {
                                            <option value="@item.ID"
                                                    @(SaleInvoiceFinancialDetails.TaxID == item.ID ? "selected" : "")
                                                    data-percentage="@item.Percentage"
                                                    data-payment-mode="@item.PaymentMode">
                                                @item.Title
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Subtotal After Tax</label>
                                <input type="number" class="form-control" name="SubtotalAfterTax" value="@SaleInvoiceFinancialDetails.SubtotalAfterTax" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Paid Amount</label>
                                <input type="number" class="form-control" name="PaidAmount" value="@SaleInvoiceFinancialDetails.PaidAmount" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Remaining Amount</label>
                                <input type="number" class="form-control" name="RemainingAmount" value="@SaleInvoiceFinancialDetails.RemainingAmount" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Return Amount</label>
                                <input type="number" class="form-control" name="ReturnAmount" value="@SaleInvoiceFinancialDetails.ReturnAmount" readonly />
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card-footer">
        <div class="row d-flex justify-content-end">
            <div class="col-4 d-flex justify-content-between">
                <button type="button" id="saveInvoiceBtn" class="btn btn-block btn-success float-right mr-1 mt-0">
                    Save & Exit
                </button>
                <button type="button" id="saveAndPrintInvoiceBtn" class="btn btn-block btn-primary-custom ml-2 mt-0">
                    Save & Print
                </button>
            </div>
        </div>
    </div>
</div>

@*<form id="permissionsForm">
        <input type="hidden" name="isEMRIntegrationAllowed" value="@(user.IntegrateEMRInCoreMedixPharmacy ? "1" : "0")" />
    </form>*@

@section Scripts{
    <script src="~/panel-assets/plugins/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>
    <script src="~/panel-assets/plugins/photoviewer/photoviewer.min.js"></script>
    <script>
        var discountsList = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Discounts));
        var referralOrderID = @Model.ReferralOrderID;

        var SaveSaleUrl = '@Url.Action("SaveSale", "Sales")';
        var saleInvoicesUrl = '@Url.Action("SaleInvoices", "Sales")';
        var printSaleInvoiceThermalUrl = '@Url.Action("PrintSaleInvoiceThermalV2", "Print")';
    </script>
    <script src="~/JSModels/Sales/manageInvoiceReturn.js"></script>
}