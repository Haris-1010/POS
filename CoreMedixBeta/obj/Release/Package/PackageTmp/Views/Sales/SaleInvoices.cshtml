@model CoreMedixBeta.Models.Sales.SaleInvoicesVM
@{
    ViewBag.Title = "SaleInvoices";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <link href="~/assets/AdminLTE/plugins/jquery-ui/jquery-ui.css" rel="stylesheet" />
    <link href="~/panel-assets/plugins/DateRange/daterangepicker.css" rel="stylesheet" />
    <style>
        th, td {
            padding-left: 5px !important;
        }

        select[name="invoicesTable_length"] {
            margin-top: -4px !important;
        }
    </style>
}

<div class="row mb-3" id="salesInfoContainer">
    <div class="col-lg-4 col-6">
        <div class="info-box">
            <span class="info-box-icon bg-info"><i class="fas fa-file-invoice"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Invoices</span>
                <span class="info-box-number js-total-invoices">0</span>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-6">
        <div class="info-box">
            <span class="info-box-icon bg-success"><i class="fas fa-credit-card"></i></span>
            <div class="info-box-content">
                <span class="info-box-text ">Paid Payments</span>
                <span class="info-box-number js-paid">0</span>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-6">
        <div class="info-box">
            <span class="info-box-icon bg-warning"><i class="fas fa-exclamation-circle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Pending Payments</span>
                <span class="info-box-number js-pending">0</span>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-filter"></i> Invoice Filters</h3>
        <div class="card-tools">
            <button class="btn btn-tool" type="button" data-toggle="collapse" data-target="#filterCard" aria-expanded="false" aria-controls="filterCard">
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
    <form id="filterForm">
        <div id="filterCard" class="collapse">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Customer</label>
                            <input type="text" value="" autocomplete="off" class="form-control js-search-customer" required placeholder="Eg: 03001234450" />
                            <input type="hidden" name="CustomerID" value="" required>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Invoice Date Range</label>
                            <input type="text" class="form-control" autocomplete="off" name="Date" placeholder="Select date range">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Payment Mode</label>
                            <select class="form-control js-select2" name="PaymentMode">
                                <option value="">All</option>
                                <option value="Cash">Cash</option>
                                <option value="JazzCash">JazzCash</option>
                                <option value="EasyPaisa">EasyPaisa</option>
                                <option value="Card">Card</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Total Amount</label>
                            <input type="number" class="form-control" name="TotalAmount" placeholder="Enter amount">
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Sort By</label>
                                    <select class="form-control js-select2" name="SortBy">
                                        <option value="ID" selected>Latest</option>
                                        <option value="InvoiceDate">Date</option>
                                        <option value="CustomerName">Customer Name</option>
                                        <option value="NetTotal">Net Total</option>
                                        <option value="PaidAmount">Paid Amount</option>
                                        <option value="RemainingAmount">Remaining Amount</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 pl-0">
                                <div class="form-group">
                                    <label>Order</label>
                                    <select class="form-control js-select2" name="SortByOrder">
                                        <option value="ASC" selected>Ascending</option>
                                        <option value="DESC">Descending</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3 ml-auto">
                        <div class="form-group mb-0 d-flex justify-content-between">
                            <label></label>
                            <button type="button" class="btn btn-primary-custom form-control text-nowrap js-apply-filter-btn">Apply Filter</button>
                            <button type="button" class="btn btn-default form-control js-clear-filter-btn ml-2">Clear Filter</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <input type="hidden" value="@Model.CurrencySymbol" class="form-control" id="currency">
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-file-invoice"></i> Invoices</h3>

        <div class="card-tools">
            <a href='@Url.Action("ManageInvoice", "Sales")' class="btn btn-primary-custom"><i class="fa fa-plus"></i> New Invoice</a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="invoicesTable" class="table table-striped table-hover w-100">
                <thead>
                    <tr>
                        <th>Invoice No</th>
                        <th>Date</th>
                        <th>Customer Name</th>
                        <th>Net Total</th>
                        <th>Paid Amount</th>
                        <th>Remaining Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
                <tfoot>
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<div id="saleInvoiceData" data-startdate="@Model.StartDate" data-enddate="@Model.EndDate"></div>
<div id="customerData" data-customer="@(Model.CustomerId ?? "")"></div>

