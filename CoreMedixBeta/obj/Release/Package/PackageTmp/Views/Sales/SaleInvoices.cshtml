        <input type="hidden" name="canPrint" value="@(user.IsAdmin || user.Permissions.Any(x => x.Discriminator == Constants.PharmacyPermDisc && x.Name == PharmacyUserPermissions.Sales.Print && x.IsGranted) ? "1" : "0")" />
