@section Scripts{
    <script>
     var manageInvoiceUrl = '@Url.Action("ManageInvoice", "Sales")';
    var deleteInvoiceUrl = '@Url.Action("DeleteInvoice", "Sales")'; // if you have one
    var printSaleInvoiceThermalUrl = '@Url.Action("PrintSaleInvoiceThermalV2", "Print")';
    var manageInvoiceReturnUrl = '@Url.Action("ManageInvoiceReturn", "Sales")';

        var GetSalesInfoUrl = '@Url.Action("GetSalesInfo", "Sales")';
        var GetPagedSaleUrl = '@Url.Action("GetPagedSale", "Sales")';
        var DeleteSaleUrl = '@Url.Action("DeleteSale", "Sales")';
        var SearchCustomerUrl = '@Url.Action("SearchCustomer", "Patient")';
        var SendInvoiceToCustomer = '@Url.Action("SendInvoiceToCustomer", "Sales")';
    </script>
    <script src="~/assets/js/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/panel-assets/plugins/DateRange/moment.min.js"></script>
    <script src="~/panel-assets/plugins/DateRange/daterangepicker.js"></script>
    <script src="~/JSModels/Sales/saleInvoices.js"></script>
}