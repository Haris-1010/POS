@model CoreMedixBeta.Models.Auth.ViewModels.ManageUserVM
@{
    ViewBag.Title = Model.IsNewUser ? "Create User" : "Edit User";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0" style="color: var(--cm-accent-ink);">@(Model.IsNewUser ? "Create New User" : "Edit User")</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "DashBoard")">Home</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Users", "Account")">Users</a></li>
                    <li class="breadcrumb-item active">@(Model.IsNewUser ? "Create" : "Edit")</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <form id="manageUserForm" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" id="ID" name="ID" value="@(Model.IsNewUser ? 0 : Model.ID)" />

            <div class="row">
                <!-- User Details Card -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title" style="color: var(--cm-accent-ink);">User Details</h3>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label>Username <span class="text-danger">*</span></label>
                                <input type="text" id="Username" name="Username" class="form-control"
                                       value="@(Model.IsNewUser ? "" : Model.Username)" @(Model.IsNewUser ? "" : "readonly")
                                       placeholder="Enter username" autocomplete="new-username" required />
                            </div>
                            <div class="form-group">
                                <label>Password @(Model.IsNewUser ? "*" : "(leave blank to keep current)")</label>
                                <input type="password" id="Password" name="Password" class="form-control"
                                       placeholder="@(Model.IsNewUser ? "Enter password" : "Leave blank to keep current")"
                                       autocomplete="new-password" @(Model.IsNewUser ? "required" : "") />
                            </div>
                            <div class="form-group">
                                <label>Full Name <span class="text-danger">*</span></label>
                                <input type="text" id="FullName" name="FullName" class="form-control"
                                       value="@(Model.IsNewUser ? "" : Model.FullName)" placeholder="Enter full name" autocomplete="name" required />
                            </div>
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" id="Email" name="Email" class="form-control"
                                       value="@(Model.IsNewUser ? "" : Model.Email)" placeholder="Enter email" autocomplete="email" />
                            </div>
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="text" id="Phone" name="Phone" class="form-control"
                                       value="@(Model.IsNewUser ? "" : Model.Phone)" placeholder="Enter phone number" autocomplete="tel" />
                            </div>
                            <div class="form-group">
                                <label>Role <span class="text-danger">*</span></label>
                                <select id="Role" name="Role" class="form-control" required>
                                    <option value="User" @(Model.Role == "User" ? "selected" : "")>User</option>
                                    <option value="Admin" @(Model.Role == "Admin" ? "selected" : "")>Admin</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" class="custom-control-input" id="IsActive" name="IsActive"
                                           value="true" @(Model.IsActive ? "checked" : "") />
                                    <label class="custom-control-label" for="IsActive">Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Permissions Card -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title" style="color: var(--cm-accent-ink);">Permissions</h3>
                        </div>
                        <div class="card-body">
                            @if (Model.PermissionGroups != null && Model.PermissionGroups.Count > 0)
                            {
                                foreach (var group in Model.PermissionGroups)
                                {
                                    <div class="mb-3">
                                        <h6 style="color: var(--cm-accent-ink); font-weight: bold; border-bottom: 2px solid var(--cm-accent-ink); padding-bottom: 5px;">
                                            <i class="fas fa-folder"></i> @group.Module
                                        </h6>
                                        <div class="row ml-2">
                                            @foreach (var permission in group.Permissions)
                                            {
                                                <div class="col-md-6">
                                                    <div class="custom-control custom-checkbox">
                                                        <input type="checkbox"
                                                               class="custom-control-input permission-cb"
                                                               id="perm_@permission.ID"
                                                               name="PermissionIDs"
                                                               value="@permission.ID"
                                                               @(permission.IsSelected ? "checked" : "") />
                                                        <label class="custom-control-label" for="perm_@permission.ID">
                                                            @permission.PermissionName
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">No permissions available.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="row">
                <div class="col-12">
                    <button type="submit" id="btnSave" class="btn btn-primary-custom">
                        <i class="fas fa-save"></i> @(Model.IsNewUser ? "Create User" : "Update User")
                    </button>
                    <a href="@Url.Action("Users", "Account")" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Select All / Deselect All per module
            $(document).on('change', '.select-all-module', function () {
                var module = $(this).data('module');
                var isChecked = $(this).prop('checked');
                $('.permission-cb[data-module="' + module + '"]').prop('checked', isChecked);
            });

            $('#manageUserForm').on('submit', function (e) {
                e.preventDefault();

                var id = $('#ID').val();
                var username = $('#Username').val().trim();
                var password = $('#Password').val().trim();
                var fullName = $('#FullName').val().trim();
                var email = $('#Email').val().trim();
                var phone = $('#Phone').val().trim();
                var role = $('#Role').val();
                var isActive = $('#IsActive').is(':checked');

                // Validation
                if (!username) { toastr.warning('Username is required.'); return; }
                if (!fullName) { toastr.warning('Full Name is required.'); return; }
                if (id == '0' && !password) { toastr.warning('Password is required for new user.'); return; }

                // Collect selected permission IDs
                var permissionIDs = [];
                $('input[name="PermissionIDs"]:checked').each(function () {
                    permissionIDs.push(parseInt($(this).val()));
                });

                var btn = $('#btnSave');
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.ajax({
                    url: '@Url.Action("SaveUser", "Account")',
                    type: 'POST',
                    data: {
                        ID: id,
                        Username: username,
                        Password: password,
                        FullName: fullName,
                        Email: email,
                        Phone: phone,
                        Role: role,
                        IsActive: isActive,
                        PermissionIDs: permissionIDs,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.Status) {
                            toastr.success(response.Message);
                            setTimeout(function () {
                                window.location.href = '@Url.Action("Users", "Account")';
                            }, 1000);
                        } else {
                            toastr.error(response.Message);
                            btn.prop('disabled', false).html('<i class="fas fa-save"></i> @(Model.IsNewUser ? "Create User" : "Update User")');
                        }
                    },
                    error: function () {
                        toastr.error('Technical error. Please try again.');
                        btn.prop('disabled', false).html('<i class="fas fa-save"></i> @(Model.IsNewUser ? "Create User" : "Update User")');
                    }
                });
            });
        });
    </script>
}
