<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - POS Terminal</title>
    @{
        string printLogo = CoreMedixBeta.Repositories.BrandingsRepository.GetPrintLogoUrl();
    }
    @if (!string.IsNullOrWhiteSpace(printLogo))
    {
        <link rel="icon" type="image/png" href="@printLogo" />
        <link rel="shortcut icon" type="image/png" href="@printLogo" />
    }
    else
    {
        <link rel="icon" href="~/favicon.ico" />
    }
    <script>
        (function () {
            try {
                document.documentElement.setAttribute('data-theme', 'light');
            } catch (e) { }
        })();
    </script>
    <link href="~/assets/Fonts/font.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/AdminLTE/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/assets/AdminLTE/dist/css/adminlte.min.css">
    <link href="~/ReplacementPaths/Toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/Styles/Shared/layout.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --pos-ink: #0b1437;
            --pos-ink-2: #131f52;
            --pos-green: #16a34a;
            --pos-green-soft: #e7f6ec;
            --pos-paper: #fffdf7;
            --pos-line: #dfe3ee;
            --pos-muted: #5d6474;
        }

        body.login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e9edf7;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 24px 16px;
            overflow-x: hidden;
            overflow-y: auto;
        }

        /* ---------- Terminal shell ---------- */
        .pos-terminal {
            width: 100%;
            max-width: 980px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: #fff;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(11,20,55,.18);
            animation: terminalIn .5s ease-out;
        }

        @@keyframes terminalIn {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ---------- Left: counter display ---------- */
        .pos-side {
            background: linear-gradient(160deg, var(--pos-ink) 0%, var(--pos-ink-2) 100%);
            color: #fff;
            padding: 30px 30px 0;
            display: flex;
            flex-direction: column;
            position: relative;
            min-height: 560px;
        }

        .pos-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .pos-brand-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .pos-brand h1 {
            font-size: 19px;
            font-weight: 700;
            line-height: 1.2;
        }

        .pos-brand p {
            font-size: 12px;
            color: #aab4d8;
        }

        .pos-status {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 22px;
        }

        .pos-chip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 12px;
            padding: 6px 11px;
            border-radius: 999px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.14);
            color: #dbe2fb;
        }

        .pos-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #4ade80;
            box-shadow: 0 0 0 0 rgba(74,222,128,.6);
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            70% {
                box-shadow: 0 0 0 7px rgba(74,222,128,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(74,222,128,0);
            }
        }

        .pos-clock {
            margin-top: 20px;
        }

            .pos-clock .time {
                font-size: 38px;
                font-weight: 700;
                letter-spacing: 1px;
                font-variant-numeric: tabular-nums;
            }

            .pos-clock .date {
                font-size: 13px;
                color: #aab4d8;
                margin-top: 2px;
            }

        /* Receipt strip */
        .pos-receipt-wrap {
            margin-top: auto;
            padding-top: 22px;
        }

        .pos-receipt {
            background: var(--pos-paper);
            color: #222;
            width: 100%;
            max-width: 300px;
            margin: 0 auto;
            padding: 16px 18px 26px;
            font-family: 'Courier New', Consolas, monospace;
            font-size: 12px;
            position: relative;
            border-radius: 6px 6px 0 0;
            box-shadow: 0 -6px 24px rgba(0,0,0,.25);
        }

            .pos-receipt .r-title {
                text-align: center;
                font-weight: 700;
                font-size: 13px;
            }

            .pos-receipt .r-sub {
                text-align: center;
                color: #777;
                margin-bottom: 8px;
            }

            .pos-receipt hr {
                border: 0;
                border-top: 1px dashed #b9b6aa;
                margin: 8px 0;
            }

            .pos-receipt .r-row {
                display: flex;
                justify-content: space-between;
                gap: 8px;
                padding: 1px 0;
            }

            .pos-receipt .r-total {
                font-weight: 700;
                font-size: 13px;
            }

            .pos-receipt .r-barcode {
                height: 28px;
                margin-top: 10px;
                background: repeating-linear-gradient(90deg, #111 0 2px, transparent 2px 4px, #111 4px 5px, transparent 5px 8px, #111 8px 11px, transparent 11px 12px, #111 12px 13px, transparent 13px 16px);
            }

            .pos-receipt::after {
                content: '';
                position: absolute;
                left: 0;
                right: 0;
                bottom: -8px;
                height: 8px;
                background: linear-gradient(-45deg, transparent 6px, var(--pos-paper) 0) 0 0 / 12px 8px, linear-gradient(45deg, transparent 6px, var(--pos-paper) 0) 0 0 / 12px 8px;
                background-repeat: repeat-x;
            }

        /* ---------- Right: sign in ---------- */
        .pos-main {
            padding: 40px 38px 26px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .pos-main h2 {
                font-size: 24px;
                font-weight: 700;
                color: var(--pos-ink);
            }

            .pos-main .lead {
                font-size: 14px;
                color: var(--pos-muted);
                margin: 4px 0 26px;
            }

        .pos-field {
            margin-bottom: 18px;
        }

            .pos-field label {
                display: block;
                font-size: 13px;
                font-weight: 600;
                color: #333;
                margin-bottom: 6px;
            }

        .login-label-ico {
            width: 16px;
            margin-right: 4px;
            color: var(--pos-ink-2);
        }

        .input-group {
            border-radius: 10px;
            overflow: hidden;
            border: 1.5px solid var(--pos-line);
            background: #fff !important;
            transition: border-color .2s, box-shadow .2s;
            flex-wrap: nowrap;
        }

            .input-group:focus-within {
                border-color: var(--pos-ink-2);
                box-shadow: 0 0 0 3px rgba(19,31,82,.12);
            }

            .input-group .form-control {
                border: none;
                height: 52px;
                padding: 12px 15px;
                font-size: 16px;
                background: #fff !important;
                color: #212529;
            }

                .input-group .form-control:focus {
                    box-shadow: none;
                    border: none;
                }

                .input-group .form-control::placeholder {
                    color: #a4a9b8;
                }

            .input-group .input-group-text {
                border: none;
                background: #fff !important;
                padding: 0 15px;
                color: var(--pos-ink-2);
            }

        .btn-toggle-pass {
            background: #fff !important;
            border: none;
            color: var(--pos-ink-2);
            padding: 0 16px;
            height: 100%;
            font-size: 16px;
            cursor: pointer;
            outline: none;
        }

            .btn-toggle-pass:hover, .btn-toggle-pass:focus {
                color: var(--pos-green);
            }

        .btn-login {
            width: 100%;
            height: 56px;
            border: none;
            border-radius: 12px;
            background: var(--pos-green);
            color: #fff;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: .3px;
            cursor: pointer;
            margin-top: 6px;
            box-shadow: 0 6px 16px rgba(22,163,74,.3);
            transition: transform .15s, box-shadow .15s, background .15s;
        }

            .btn-login:hover {
                background: #12873d;
                box-shadow: 0 8px 20px rgba(22,163,74,.35);
            }

            .btn-login:active {
                transform: translateY(1px);
            }

            .btn-login:disabled {
                opacity: .7;
                cursor: not-allowed;
            }

            .btn-login:focus-visible, .btn-toggle-pass:focus-visible {
                outline: 3px solid rgba(19,31,82,.35);
                outline-offset: 2px;
            }

        .pos-hints {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            margin-top: 20px;
            font-size: 12px;
            color: var(--pos-muted);
        }

            .pos-hints i {
                color: var(--pos-green);
                margin-right: 5px;
            }

        .login-footer {
            margin-top: auto;
            padding-top: 22px;
            text-align: center;
            font-size: 12px;
            color: #98a0b3;
        }

        /* ---------- Responsive ---------- */
        @@media (max-width: 820px) {
            .pos-terminal {
                grid-template-columns: 1fr;
                max-width: 460px;
            }

            .pos-side {
                min-height: 0;
                padding: 22px 22px 22px;
            }

            .pos-receipt-wrap, .pos-clock {
                display: none;
            }

            .pos-status {
                margin-top: 14px;
            }

            .pos-main {
                padding: 28px 22px 22px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .pos-terminal, .pos-dot {
                animation: none;
            }
        }
    </style>
    <link href="~/Styles/Shared/theme.css" rel="stylesheet" />
</head>
<body class="login-page">
    @RenderBody()

    <script src="~/assets/AdminLTE/plugins/jquery/jquery.min.js"></script>
    <script src="~/assets/AdminLTE/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/AdminLTE/plugins/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/assets/AdminLTE/plugins/jquery-validation/additional-methods.min.js"></script>
    <script src="~/ReplacementPaths/Toastr/toastr.min.js"></script>
    @RenderSection("Scripts", false)
</body>
</html>
