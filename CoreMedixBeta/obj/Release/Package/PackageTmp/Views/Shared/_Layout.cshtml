            <div id="chatbot-container" class="card" style="display: none;">
                <div class="card-header">
                    <div class="d-flex align-items-center"> 
                        <h5 class="card-title mb-0 text-white">Pharmacy Assistant</h5>
                    </div>
                    <button class="btn btn-sm btn-light js-close-chatbot">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div class="card-body p-0 d-flex flex-column">
                    <!-- Chat messages will appear here -->
                    <div id="botui-app" class="flex-grow-1"></div>

                    <div class="card-footer">
                        <div class="input-group">
                            <input type="text" id="chatbot-input" class="form-control"
                                   placeholder="Ask about stock, patients, sales..." autocomplete="off" />
                            <div class="input-group-append">
                                <button class="btn btn-primary js-send-message">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <button id="chatbot-toggle" class="btn">
