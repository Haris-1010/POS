    </audio>

    <!-- Generic Excel Export Modal -->
    <div class="modal fade" id="excelExportModal" tabindex="-1" role="dialog" aria-labelledby="excelExportModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <form id="excelExportForm">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Download Excel Report</h5>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <label>Select Date Range</label>
                        <input type="text" id="excelDateRange" class="form-control" required />
                        <input type="hidden" id="reportTarget" />
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Download</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
