@model CoreMedixBeta.Models.Menufacturer.ManufacturersVM
@using CoreMedixBeta.Models.Menufacturer
@{
    ViewBag.Title = "Manufacturers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles{
    <style>
        select[name="manufacturersTable_length"] {
            margin-top: -4px !important;
        }
    </style>
}
<div class="card">
    <div class="card-header d-flex justify-content-between">
        <div class="card-title font-weight-bold primary-text mt-2">
            Manufacturers
        </div>
        <div class="ml-auto">

            <button class="btn btn-primary-custom text-left" id="addManufacturerBtn" data-target="#saveManufacturerModal" data-toggle="modal" data-backdrop="static" data-keyboard="false">
                <i class="fas fa-plus"></i> Add Manufacturer
            </button>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-hover w-100 table-responsive-sm" id="manufacturersTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>City</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="saveManufacturerModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title primary-text font-weight-bold ">Save Manufacturer</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Manufacturer Name<span class="required">*</span></label>
                                <input type="text" class="form-control" name="Name" required maxlength="@Manufacturer.MaxNameLength" minlength="@Manufacturer.MinNameLength" placeholder="Enter Manufacturer name" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Phone<span class="required">*</span></label>
                                <input type="number" class="form-control" name="Phone" required maxlength="@Manufacturer.MaxPhoneLength" minlength="@Manufacturer.MinPhoneLength" placeholder="e.g 03xxxxxxxxx" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" class="form-control" name="Email" placeholder="example@gmail.com" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>City<span class="required">*</span></label><br />
                                <select class="form-control js-form-city js-select2" required name="City">
                                    <option value="">Select City</option>
                                    @foreach (var city in Model.Cities)
                                    {
                                        <option value="@city">@city</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <input type="hidden" name="ID" value="0" />
                        @*<input type="hidden" name="CreatedBy" value="@username" required />
                            <input type="hidden" name="LastModifiedBy" value="@username" required />
                            <input type="hidden" name="LocationID" value="@user.LocationID" required />
                            <input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary-custom js-save-btn">Save</button>
            </div>
        </div>
    </div>
</div>

@*<form id="manufacturerPermissionsForm">
        <input type="hidden" name="canCreate" value="@(user.IsAdmin || user.Permissions.Any(x => x.Discriminator == "PharmacyUserPermissionSetting" && x.Name == PharmacyUserPermissions.Manufacturer.Create && x.IsGranted) ? "1" : "0")" />
        <input type="hidden" name="canUpdate" value="@(user.IsAdmin || user.Permissions.Any(x => x.Discriminator == "PharmacyUserPermissionSetting" && x.Name == PharmacyUserPermissions.Manufacturer.Update && x.IsGranted) ? "1" : "0")" />
        <input type="hidden" name="canDelete" value="@(user.IsAdmin || user.Permissions.Any(x => x.Discriminator == "PharmacyUserPermissionSetting" && x.Name == PharmacyUserPermissions.Manufacturer.Delete && x.IsGranted) ? "1" : "0")" />
    </form>*@

@section Scripts{
    <script>
        var getManufacturerUrl = '@Url.Action("GetPagedManufacturers", "Manufacturers")';
        var saveManufacturerUrl = '@Url.Action("SaveManufacturer", "Manufacturers")';
        var deleteManufacturerUrl = '@Url.Action("DeleteManufacturer", "Manufacturers")';
        var brandUrl = '@Url.Action("Brand", "Brands")';
    </script>
    <script src="~/JSModels/Manufacturer/manufacturers.js"></script>
}