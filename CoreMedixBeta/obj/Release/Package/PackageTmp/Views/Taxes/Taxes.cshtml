    <script>

        var SaveTaxUrl = '@Url.Action("SaveTax", "Taxes")';
        var GetPagedTaxesUrl = '@Url.Action("GetPagedTaxes", "Taxes")';
        var DeleteTaxUrl = '@Url.Action("DeleteTax", "Taxes")';
    </script>
    <script src="~/JSModels/Taxes/taxes.js"></script>
