<html>
<head>
    <meta charset="utf-8">
    <title>Purchase Order</title> 
    <link rel="icon" href="~/assets/AdminLTE/dist/img/heart-logo.png">
    <link rel="stylesheet" href="~/assets/AdminLTE/dist/css/adminlte.min.css">
</head>
<body class="mx-auto">
    <header class="pb-3 mb-3">
        <br>
        <div class="row d-flex justify-content-center">
            <h3 class="text-bold">Purchase Order</h3>
        </div><br>

        <div class="row">
            <div class="col-6">
                <img class="img-responsive"
                     src="@(isBranding && !string.IsNullOrWhiteSpace(branding.Logo) ? branding.Logo : "")"
                     width="100" />
            </div>
            <div class="col-6 d-flex justify-content-end">
                <p><small>InstaCare CoreMedix <br>Award Winning & No.1 Choice<br> of Doctors </small></p>
            </div>
        </div>
    </header>

    <div class="row">
        <div class="col-5">
            <table>
                <tr>
                    <th style="width:40%"><span class="font-weight-bold">Reference No</span></th>
                    <td><span>@Order.ReferenceNo</span></td>
                </tr>
                <tr>
                    <th><span class="font-weight-bold">Purchase Date</span></th>
                    <td><span>@Order.OrderDateFormatted</span></td>
                </tr>
                <tr>
                    <th><span class="font-weight-bold">Supplier Details</span></th>
                    <td><span>@Order.SupplierName - @Order.SupplierPhone</span></td>
                </tr> 
                <tr>
                    <th><span class="font-weight-bold">Purchase Status</span></th>
                    <td><span>@Order.Status</span></td>
                </tr>
            </table>
        </div>
    </div>
    <br />
    <p class="font-weight-bold mb-1">Item Details</p>
    <table>
        <thead>
            <tr class="font-weight-bold">
                <th class="text-center">Item</th>
                <th class="text-center">Rate</th>
                <th class="text-center">Qty</th>
                <th class="text-center">Tax</th>
                <th class="text-center">Line Total</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.DetailedOrder.OrderItems != null && Model.DetailedOrder.OrderItems.Count > 0)
            {
                foreach (var item in Model.DetailedOrder.OrderItems)
                {
                    <tr>
                        <td style="text-align: center">@item.Name </td>
                        <td style="text-align: center">@Model.CurrencySymbol @item.UnitCost.ToString("N2")</td>
                        <td style="text-align: center">@item.Qty</td>
                        <td style="text-align: center">@Model.CurrencySymbol @((item.UnitCostWithTax - item.UnitCost).ToString("N2"))</td>
                        <td style="text-align: center">@Model.CurrencySymbol @item.LineTotal.ToString("N2")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <br />
    <div class="row justify-content-end">
        <div class="col-4">
            <table>
                <tr>
                    <th><span class="font-weight-bold">Sub Total</span></th>
                    <td><span>@Model.CurrencySymbol @Order.SubTotal.ToString("N2")</span></td>
                </tr>
            </table>
        </div>
    </div>
    @*<footer class="main-footer text-center">
            <h5 class="" style="margin:0% !important;"> <a href="https://instacare.pk/">Instacare.pk</a> | <a href="hello@instacare.pk">hello@instacare.pk</a> | <a href="+923094447191"> +923094447191</a>, <a href="+923094443712"> +923094443712</a></h5>
            <p style="margin-bottom:0% !important; font-size:12px !important;">This invoice has been computer-generated using Integris ERP Software.</p>
        </footer>*@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.print();
        });
    </script>
</body>
</html>