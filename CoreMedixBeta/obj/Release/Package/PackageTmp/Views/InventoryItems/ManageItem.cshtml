@model CoreMedixBeta.Models.InventoryItems.ManageItemViewModel
@using CoreMedixBeta.Models.Menufacturer
@using CoreMedixBeta.Models.InventoryItems
@using CoreMedixBeta.Models.Supplier
@{
    ViewBag.Title = "ManageItem";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles
{
    <link href="~/panel-assets/plugins/bootstrap-datepicker/bootstrap-datepicker.min.css" rel="stylesheet" />
    <link href="~/CSSModels/InventoryItems/manageItem.css" rel="stylesheet" />
    @*<style>
            .js-form-city {
                width: 100% !important;
                z-index: 999 !important;
            }
        </style>*@
<style>
    select[name="variationsTable_length"] {
        margin-top: -4px !important;
    }
</style>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Item Information</h3>
    </div>
    <div class="card-body">
        <form id="itemInfoForm">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Name<span class="required">*</span></label>
                        <input type="text" class="form-control" name="Name"
                               value="@(Model != null && Model.Item != null && Model.Item.ID > 0 ? Model.Item.Name : string.Empty)"
                               placeholder="Product Name" required />
                    </div>
                </div>
                @{
                    string manufactureName = string.Empty;
                    int manufactureID = 0;

                    if (Model != null && Model.Item != null && Model.Item.ID > 0)
                    {
                        var matched = Model.Manufacturers.FirstOrDefault(m => m.ID == Model.Item.ManufacturerID);
                        if (matched != null)
                        {
                            manufactureName = matched.Name;
                            manufactureID = matched.ID;
                        }
                    }
                }

                <div class="col-md-3 col-sm-6">
                    <div class="form-group">
                        <label for="">Manufacturer <span class="required">*</span></label>
                        <input type="text" name="ManufacturerName" autocomplete="off" class="form-control js-search-manufacturer" required placeholder="Eg: Haris Yahya" value="@manufactureName" />
                        <input type="hidden" name="ManufacturerID" value="@manufactureID" />
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <div class="form-group">
                        <label for="">Brand</label>
                        <select class="form-control js-select2" name="BrandID">
                            <option value="">Choose Brand</option>
                            @if (Model != null && Model.ManufacturerBrands != null && Model.ManufacturerBrands.Any())
                            {
                                foreach (var item in Model.ManufacturerBrands)
                                {
                                    var isSelected = Model.Item != null && Model.Item.BrandID > 0;

                                    <option value="@item.ID" @(isSelected ? "selected" : "")>@item.Title</option>
                                }
                            }
                            else
                            {
                                <option disabled>No Suppliers available</option>
                            }
                        </select>
                    </div>
                </div>
                @*<div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label for="">Supplier<span class="required">*</span></label>
                            <select class="form-control js-select2" name="SupplierID" multiple required>
                                <option value="">Choose Supplier</option>
                                @if (Model != null && Model.Suppliers != null && Model.Suppliers.Any())
                                {
                                    foreach (var item in Model.Suppliers)
                                    {
                                        var isSelected = Model.Item != null && Model.Item.SupplierID != null &&
                                  Model.Item.SupplierID.Split(',').Contains(item.ID.ToString());

                                <option value="@item.ID" @(isSelected ? "selected" : "")>@item.Name</option>
                            }
                        }
                        else
                        {
                            <option disabled>No Suppliers available</option>
                        }
                            </select>
                        </div>
                    </div>*@ 
                @{
                    var supplier = (Model != null && Model.Item != null && Model.Item.ID > 0)
                        ? Model.Suppliers.FirstOrDefault(m => m.ID.ToString() == Model.Item.SupplierID)
                        : null;

                    var supplierName = supplier != null ? supplier.Name : "";
                    var supplierID = supplier != null ? supplier.ID : 0;
                }

                <div class="col-md-3 col-sm-6">
                    <div class="form-group">
                        <label for="">Supplier <span class="required">*</span></label>
                        <input type="text" name="SupplierName" autocomplete="off" class="form-control js-search-supplier" required placeholder="Eg: Haris Yahya" value="@supplierName" />
                        <input type="hidden" name="SupplierID" value="@supplierID" />
 
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="form-group">
                        <label for="productType">Type<span class="required">*</span></label>
                        <select class="form-control js-select2" id="productType" name="ProductType" required>
                            <option value="">Select Product</option>
                            <option value="Medicine" @(Model != null && Model.Item != null && Model.Item.ProductType == "Medicine" ? "selected" : "")>
                                Medicine
                            </option>
                            <option value="Other" @(Model != null && Model.Item != null && Model.Item.ProductType == "Other" ? "selected" : "")>
                                Other
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 js-salt-input" @(Model != null && Model.Item != null && Model.Item.ProductType == "Medicine" ? "" : "hidden")>
                    <label>Generic</label>
                    <div class="form-group">
                        <select class="form-control" style="min-width : 30px" name="MedicineSalt" multiple="multiple"></select>
                    </div>
                </div>
                <input type="hidden" name="MedicineSaltHidden"
                       value="@(Model != null && Model.Item != null && !string.IsNullOrEmpty(Model.Item.MedicineSalt) ? Model.Item.MedicineSalt : "")" />
                <input type="hidden" name="ID" value="@(Model.Item != null && Model.Item.ID > 0 ? Model.Item.ID : 0)" />
                @*<input type="hidden" name="CreatedBy" value="@username" required />
                    <input type="hidden" name="LastModifiedBy" value="@username" required />
                    <input type="hidden" name="LocationID" value="@user.LocationID" required />
                    <input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@
            </div>
            <div class="row">
                <div class="col-12 text-center">
                    <button type="button" class="btn btn-primary-custom js-save-btn">Save Item</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    @if (Model != null && Model.ItemID > 0)
    {
        <div class="card-header d-flex justify-content-between align-items-baseline">
            <h3 class="card-title primary-text font-weight-bold">Variations</h3>
            <div class="card-tools ml-auto">
                <button type="button" class="btn btn-primary-custom" data-toggle="modal" data-target="#addVariationModal"><i class="fa fa-plus-circle"></i> Add Variation</button>
            </div>
        </div>
    }
    else
    {
        <div class="card-header d-flex justify-content-between align-items-baseline">
            <h3 class="card-title primary-text font-weight-bold">Variations (Please save the item first to add variations)</h3>
        </div>
    }
    <div class="card-body">
        <div class="table-responsive w-100">
            <table class="table table-hover table-bordered table-striped w-100" id="variationsTable">
                <thead>
                    <tr>
                        <th class="cutom-th">Name</th>
                        <th class="cutom-th">SKU</th>
                        <th class="cutom-th">Formation</th>
                        <th class="cutom-th">Weight</th>
                        <th class="cutom-th">Qty</th>
                        <th class="cutom-th">No Of Pills In Pack</th>
                        <th class="cutom-th">Available Packs</th>
                        <th class="cutom-th">Opening Stock Rate</th>
                        <th class="cutom-th">Reorder Point</th>
                        <th class="cutom-th">Sale Price</th>
                        <th class="cutom-th">Cost Price</th>
                        <th class="cutom-th">Expiry Date</th>
                        <th class="cutom-th">Category</th>
                        <th class="cutom-th">Sub Category</th>
                        <th class="cutom-th">Unit</th>
                        <th class="cutom-th">UPC</th>
                        <th class="cutom-th">Batch</th>
                        <th class="cutom-th">Margin%</th>
                        <th class="cutom-th">Tax%</th>
                        <th class="cutom-th">Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="addVariationModal" data-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title js-modal-title">Add Variation</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input type="hidden" value="0" name="ID" />
                    <input type="hidden" name="ItemID" value="@Model.ItemID" />
                    @*<input type="hidden" name="CreatedBy" value="@username" required />
                        <input type="hidden" name="LastModifiedBy" value="@username" required />*@
                    <div class="row">
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label for="itemUPC" data-toggle="tooltip" title="Twelve digit unique number associated with bar code. (Universal Product Code)">
                                    UPC (Scan Barcode)
                                    <i class="fas fa-question-circle bg-white" data-bs-toggle="tooltip"></i>
                                </label>

                                <div class="input-group">
                                    <input type="text" class="form-control" id="itemUPC" name="UPC" placeholder="Enter UPC">
                                    <div class="input-group-append">
                                        <button type="button" id="generateBarcodeBtn" class="btn btn-outline-primary" title="Generate Barcode">
                                            <i class="fas fa-barcode"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label>Variation Name<span class="required">*</span></label>
                                <input type="text" class="form-control" name="VariationName" required placeholder="Variation Name">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label for="itemSKU" data-toggle="tooltip" title="The unique code used to track and manage inventory efficiently.">
                                    SKU<span class="required">*</span>
                                    <i class="fas fa-question-circle bg-white" data-bs-toggle="tooltip"></i>
                                </label>
                                <input type="number" class="form-control" id="itemSKU" name="SKU" required placeholder="Enter SKU">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label for="itemUnit">Formation</label>
                                <div class="input-group">
                                    <select class="form-control" name="FormationID">
                                        <option value="0">Select Product Formation</option>
                                        @if (Model.AllAttributes != null && Model.AllAttributes.Count > 0)
                                        {
                                            foreach (var Attribute in Model.AllAttributes)
                                            {
                                                if (Attribute.Type == "Formation")
                                                {
                                                    <option value="@Attribute.ID">@Attribute.Name</option>
                                                }
                                            }
                                        }
                                    </select>
                                    <div class="input-group-append">
                                        <button class="btn btn-success js-add-property-btn" type="button" data-type="Formation">+</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label for="Weight"><strong>Weight</strong></label>
                                <div style="display: flex; gap: 5px;">
                                    <input type="number" id="Weight" name="Weight" class="form-control" style="width: 60%;" placeholder="Enter weight" />
                                    <select name="WeightUnitID" class="form-control" style="width: 40%;">
                                        @if (Model.AllAttributes != null && Model.AllAttributes.Count > 0)
                                        {
                                            foreach (var Attribute in Model.AllAttributes)
                                            {
                                                if (Attribute.Type == "WeightUnit")
                                                {
                                                    <option value="@Attribute.ID">@Attribute.Name</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label>Opening Stock (Qty)<span class="required">*</span></label>
                                <input type="number" class="form-control" name="OpeningStock" required placeholder="Enter opening stock">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label>Opening Stock Rate<span class="required">*</span></label>
                                <input type="number" class="form-control" required name="OpeningStockRate" placeholder="Enter opening stock rate">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label>No. of Items/Pills in Pack<span class="required">*</span></label>
                                <input type="number" class="form-control" name="NoOfPillsInPack" required placeholder="Enter No. of Pills in Pack">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label data-toggle="tooltip" title="The rate at which you are going to sell this item.">
                                    Selling Price<span class="required">*</span>
                                    <i class="fas fa-question-circle bg-white" data-bs-toggle="tooltip"></i>
                                </label>
                                <input type="number" class="form-control" name="SellingPrice" required placeholder="Enter selling price">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label data-toggle="tooltip" title="The rate at which you purchased this item.">
                                    Cost Price<span class="required">*</span>
                                    <i class="fas fa-question-circle bg-white" data-bs-toggle="tooltip"></i>
                                </label>
                                <input type="number" class="form-control" name="CostPrice" required placeholder="Enter cost price">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label>Reorder Point<span class="required">*</span></label>
                                <input type="number" class="form-control" name="ReorderPoint" required placeholder="Enter reorder point">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label>Expiry<span class="required">*</span></label>
                                <input type="text" class="form-control js-date-picker" name="ExpiryDate" required placeholder="Enter Expiry Date">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label for="itemUnit">Category</label>
                                <div class="input-group">
                                    <select class="form-control" name="CategoryID">
                                        <option value="0">Select a Category</option>
                                        @if (Model.AllAttributes != null && Model.AllAttributes.Count > 0)
                                        {
                                            foreach (var Attribute in Model.AllAttributes)
                                            {
                                                if (Attribute.Type == "Category")
                                                {
                                                    <option value="@Attribute.ID">@Attribute.Name</option>
                                                }
                                            }
                                        }
                                    </select>
                                    <div class="input-group-append">
                                        <button class="btn btn-success js-add-property-btn" type="button" data-type="Category">+</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label for="itemUnit">Sub Category</label>
                                <div class="input-group">
                                    <select class="form-control" name="SubCategoryID">
                                        <option value="0">Select sub category</option>
                                        @if (Model.AllAttributes != null && Model.AllAttributes.Count > 0)
                                        {
                                            foreach (var Attribute in Model.AllAttributes)
                                            {
                                                if (Attribute.Type == "Subcategory")
                                                {
                                                    <option value="@Attribute.ID">@Attribute.Name</option>
                                                }
                                            }
                                        }
                                    </select>
                                    <div class="input-group-append">
                                        <button class="btn btn-success js-add-property-btn" type="button" data-type="Subcategory">+</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label for="itemUnit">Unit</label>
                                <div class="input-group">
                                    <select class="form-control" name="UnitID">
                                        <option value="0">Select a Unit</option>
                                        @if (Model.AllAttributes != null && Model.AllAttributes.Count > 0)
                                        {
                                            foreach (var Attribute in Model.AllAttributes)
                                            {
                                                if (Attribute.Type == "Unit")
                                                {
                                                    <option value="@Attribute.ID">@Attribute.Name</option>
                                                }
                                            }
                                        }
                                    </select>
                                    <div class="input-group-append">
                                        <button class="btn btn-success js-add-property-btn" type="button" data-type="Unit">+</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label>Batch No#</label>
                                <input type="text" class="form-control" name="Batch" placeholder="Enter reorder point">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label>Margin %</label>
                                <input type="number" class="form-control" name="Margin" placeholder="Enter MRP">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label data-toggle="tooltip" title="Item Tax">
                                    Tax %
                                    <i class="fas fa-question-circle bg-white" data-bs-toggle="tooltip"></i>
                                </label>
                                <input type="number" class="form-control" name="Tax" placeholder="Enter Item Tax">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label>Search Alternates Items</label>
                                <input type="text" class="form-control" name="SearchAlternate" placeholder="Search Alternate Items">
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-8">
                            <div class="form-group">
                                <label>Alternates Items</label>
                                <select class="form-control" name="AlternateItems" multiple="multiple"></select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary-custom js-save-btn">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="variationImagesModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Variation Images</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input type="hidden" value="0" name="VariationID" />
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label>Images<span class="required">*</span></label>
                                <input type="file" class="form-control js-image-input" name="images" accept="image/*">
                                <div class="js-image-preview-container mt-3"></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary js-close-modal" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary-custom js-save-btn">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="saveItemAttributeModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title js-modal-title primary-text font-weight-bold">Create Item</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="form-group">
                        <label for="itemTitle">Title <span class="required-star">*</span></label> 
                        <input type="text" class="form-control" id="itemTitle" name="Title" required maxlength="@ItemAttribute.MaxTitleLength" minlength="@ItemAttribute.MinTitleLength" placeholder="Enter Tittle" />
                    </div>
                    <input type="hidden" name="ID" value="0" />
                    <input type="hidden" name="Type" value="" required />
                    @*<input type="hidden" name="CreatedBy" value="@username" required />
                        <input type="hidden" name="LastModifiedBy" value="@username" required />
                        <input type="hidden" name="LocationID" value="@user.LocationID" required />
                        <input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary js-close-modal" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary-custom js-save-btn">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="saveManufacturerModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title primary-text font-weight-bold ">Save Manufacturer</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Manufacturer Name<span class="required">*</span></label>
                                <input type="text" class="form-control" name="Name" required maxlength="@Manufacturer.MaxNameLength" minlength="@Manufacturer.MinNameLength" placeholder="Enter Manufacturer name" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Phone<span class="required">*</span></label>
                                <input type="number" class="form-control" name="Phone" required maxlength="@Manufacturer.MaxPhoneLength" minlength="@Manufacturer.MinPhoneLength" placeholder="e.g 03xxxxxxxxx" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" class="form-control" name="Email" placeholder="example@gmail.com" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>City<span class="required">*</span></label><br />
                                <select class="form-control js-form-city js-select2" required name="City">
                                    <option value="">Select City</option>
                                    @foreach (var city in Model.Cities)
                                    {
                                        <option value="@city">@city</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <input type="hidden" name="ID" value="0" />
                        @*<input type="hidden" name="CreatedBy" value="@username" required />
                            <input type="hidden" name="LastModifiedBy" value="@username" required />
                            <input type="hidden" name="LocationID" value="@user.LocationID" required />
                            <input type="hidden" name="MasterUsername" value="@user.MasterUsername" required />*@
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary-custom js-save-btn">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="saveSupplierModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title primary-text font-weight-bold ">Save Supplier</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Supplier Name<span class="required">*</span></label>
                                <input type="text" class="form-control" name="Name" required maxlength="@Supplier.MaxNameLength" minlength="@Supplier.MinNameLength" placeholder="Enter Supplier name" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Phone<span class="required">*</span></label>
                                <input type="number" class="form-control" name="Phone" required maxlength="@Supplier.MaxPhoneLength" minlength="@Supplier.MinPhoneLength" placeholder="e.g 03xxxxxxxxx" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" class="form-control" name="Email" placeholder="example@gmail.com" />
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="form-group">
                                <label>City<span class="required">*</span></label><br />
                                <select class="form-control js-select2 js-form-citySup" required name="City">
                                    <option value="">Select City</option>
                                    @foreach (var city in Model.Cities)
                                    {
                                        <option value="@city">@city</option>
                                    }
                                </select>
                            </div>
                        </div>
                        @*<div class="col-md-6 col-sm-12">
                                <div class="form-group">
                                    <label>Area<span class="required">*</span></label><br />
                                    <select class="form-control js-form-area  js-select2" required name="Area">
                                        <option value="">Select Area</option>
                                    </select>
                                </div>
                            </div>*@
