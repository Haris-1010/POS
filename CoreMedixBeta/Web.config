			</authorization>
		</system.web>
	</location>
	<!-- Allows the Windows Scheduled Task to reach the scheduler endpoint.
	     Access is still protected by the BackupSchedulerKey shared secret
	     validated inside BackupSettingsController.ScheduledBackup. -->
	<location path="BackupSettings/ScheduledBackup">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

