		<add key="EOcenasSC_API_ContentType" value="application/json" />
		<add key="EOcenasSC_API_ShortCode" value="your-eocean-short-code" />
		<add key="StorageConnectionString" value="UseDevelopmentStorage=true" />
		<!-- Shared secret used by the Windows Scheduled Task to call
		     BackupSettings/ScheduledBackup. Change this value and update the
		     scheduled task (see Scripts/Setup-BackupScheduledTask.ps1). -->
		<add key="BackupSchedulerKey" value="fe12fb7402b249089103d77d737caef9fa47457208774ac59948a3faa3f36510" />
	</appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />
		<authentication mode="Forms">
			<forms loginUrl="~/Account/Login" timeout="480" slidingExpiration="true" />
		</authentication>
		<sessionState timeout="480" />
		<authorization>
			<deny users="?" />
		</authorization>
	</system.web>
	<location path="Account">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="Content">
