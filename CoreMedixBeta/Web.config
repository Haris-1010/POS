		<add key="emailusername" value="username" />
		<add key="emailpassword" value="password" />
		<add key="SendGridAPIKey" value="your-sendgrid-key" />
		<add key="TokenPrintFontSize" value="12" />
		<add key="TokenPrintPageHeight" value="100" />
		<add key="MicrosoftCS" value="your-microsoft-cs-key" />
		<add key="GooglePlacesApi" value="your-google-places-api-key" />
