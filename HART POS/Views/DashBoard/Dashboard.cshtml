@model HARTPOS.Models.DashBoard.DashBoardVM
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isUpdate = Model.DashboardSettings != null && Model.DashboardSettings.Count > 0;
    var cards = Model.DashBoardCards ?? new List<HARTPOS.Models.DashBoard.DashBoardCard>();
    var values = Model.DashBoardCardsValues;
    var fullName = Session["FullName"] != null ? Session["FullName"].ToString() : "User";
    var today = DateTime.Now;
    var initial = string.IsNullOrWhiteSpace(fullName) ? "U" : fullName.Trim().Substring(0, 1).ToUpper();

    var DashBoardCards = new[]
    {
        new { Title = "Sales", CardID = 1 },
        new { Title = "Total Invoices", CardID = 2 },
        new { Title = "Profit", CardID = 3 },
        new { Title = "Total Customers", CardID = 4 },
        new { Title = "Stock Value", CardID = 5 },
        new { Title = "Expiring Soon", CardID = 6 },
        new { Title = "Stock Sold Value", CardID = 7 },
        new { Title = "Amount Receivable", CardID = 8 }
    };

    // [0] = accent colour, [1] = soft tint
    var themes = new Dictionary<int, string[]>
    {
        { 1, new[] { "#090650", "rgba(9,6,80,0.10)" } },
        { 2, new[] { "#2563eb", "rgba(37,99,235,0.12)" } },
        { 3, new[] { "#16a34a", "rgba(22,163,74,0.12)" } },
        { 4, new[] { "#7c3aed", "rgba(124,58,237,0.12)" } },
        { 5, new[] { "#0d9488", "rgba(13,148,136,0.12)" } },
        { 6, new[] { "#dc2626", "rgba(220,38,38,0.12)" } },
        { 7, new[] { "#4f46e5", "rgba(79,70,229,0.12)" } },
        { 8, new[] { "#b45309", "rgba(180,83,9,0.12)" } }
    };

    var cardI18nKeys = new Dictionary<int, string>
    {
        { 1, "dash_card_sales" }, { 2, "dash_card_invoices" }, { 3, "dash_card_profit" },
        { 4, "dash_card_customers" }, { 5, "dash_card_stock_value" }, { 6, "dash_card_expiring" },
        { 7, "dash_card_stock_sold" }, { 8, "dash_card_receivable" }
    };
    var moneyIds = new HashSet<int> { 1, 3, 5, 7, 8 };

}

@section styles{
    <style>
        /* ===== Switch / checkbox used in the settings panel (unchanged) ===== */
        @@supports (-webkit-appearance: none) or (-moz-appearance: none) {
            .checkbox-wrapper input[type=checkbox] {
                --active: var(--cm-accent-ink);
                --active-inner: #fff;
                --focus: 2px rgba(39, 94, 254, .3);
                --border: #BBC1E1;
                --border-hover: #BBC1E1;
                --background: var(--cm-surface);
                --disabled: #F6F8FF;
                --disabled-inner: #E1E6F9;
                -webkit-appearance: none;
                -moz-appearance: none;
                height: 21px;
                outline: none;
                display: inline-block;
                vertical-align: top;
                position: relative;
                margin: 0;
                cursor: pointer;
                border: 1px solid var(--bc, var(--border));
                background: var(--b, var(--background));
                transition: background 0.3s, border-color 0.3s, box-shadow 0.2s;
            }

                .checkbox-wrapper input[type=checkbox]:after {
                    content: "";
                    display: block;
                    left: 0;
                    top: 0;
                    position: absolute;
                    transition: transform var(--d-t, 0.3s) var(--d-t-e, ease), opacity var(--d-o, 0.2s);
                }

                .checkbox-wrapper input[type=checkbox]:checked {
                    --b: var(--active);
                    --bc: var(--active);
                    --d-o: .3s;
                    --d-t: .6s;
                    --d-t-e: cubic-bezier(.2, .85, .32, 1.2);
                }

                .checkbox-wrapper input[type=checkbox]:disabled {
                    --b: var(--disabled);
                    cursor: not-allowed;
                    opacity: 0.9;
                }

                    .checkbox-wrapper input[type=checkbox]:disabled:checked {
                        --b: var(--disabled-inner);
                        --bc: var(--border);
                    }

                    .checkbox-wrapper input[type=checkbox]:disabled + label {
                        cursor: not-allowed;
                    }

                .checkbox-wrapper input[type=checkbox]:hover:not(:checked):not(:disabled) {
                    --bc: var(--border-hover);
                }

                .checkbox-wrapper input[type=checkbox]:focus {
                    box-shadow: 0 0 0 var(--focus);
                }

                .checkbox-wrapper input[type=checkbox]:not(.switch) {
                    width: 21px;
                }

                    .checkbox-wrapper input[type=checkbox]:not(.switch):after {
                        opacity: var(--o, 0);
                    }

                    .checkbox-wrapper input[type=checkbox]:not(.switch):checked {
                        --o: 1;
                    }

                .checkbox-wrapper input[type=checkbox] + label {
                    display: inline-block;
                    vertical-align: middle;
                    cursor: pointer;
                    margin-left: 4px;
                }

                .checkbox-wrapper input[type=checkbox]:not(.switch) {
                    border-radius: 7px;
                }

                    .checkbox-wrapper input[type=checkbox]:not(.switch):after {
                        width: 5px;
                        height: 9px;
                        border: 2px solid var(--active-inner);
                        border-top: 0;
                        border-left: 0;
                        left: 7px;
                        top: 4px;
                        transform: rotate(var(--r, 20deg));
                    }

                    .checkbox-wrapper input[type=checkbox]:not(.switch):checked {
                        --r: 43deg;
                    }

                .checkbox-wrapper input[type=checkbox].switch {
                    width: 34px;
                    height: 20px;
                    border-radius: 10px;
                }

                    .checkbox-wrapper input[type=checkbox].switch:after {
                        left: 2px;
                        top: 2px;
                        border-radius: 50%;
                        width: 14px;
                        height: 14px;
                        background: var(--ab, var(--border));
                        transform: translateX(var(--x, 0));
                    }

                    .checkbox-wrapper input[type=checkbox].switch:checked {
                        --ab: var(--active-inner);
                        --x: 14px;
                    }

                    .checkbox-wrapper input[type=checkbox].switch:disabled:not(:checked):after {
                        opacity: 0.6;
                    }
        }

        .checkbox-wrapper * {
            box-sizing: inherit;
        }

            .checkbox-wrapper *:before,
            .checkbox-wrapper *:after {
                box-sizing: inherit;
            }

        table#dashboardSettingsTable td,
        table#dashboardSettingsTable th {
            border-top: 0;
            font-size: .9rem;
            padding: 9px 14px;
            vertical-align: middle;
        }

        table#dashboardSettingsTable tr + tr td {
            border-top: 1px solid var(--cm-border, #e6e9f2);
        }

        .p-3.control-sidebar-content {
            padding: 0 !important;
        }

        /* ===== Design tokens for this page ===== */
        .dash {
            --d-surface: var(--cm-surface, #fff);
            --d-border: var(--cm-border, #e6e9f2);
            --d-ink: var(--cm-accent-ink, #090650);
            --d-muted: var(--cm-text-muted, #6b7280);
            --d-soft: var(--cm-soft, #eef1fb);
            --d-radius: 18px;
            --d-radius-sm: 12px;
            --d-shadow: 0 1px 2px rgba(16,24,40,.05), 0 4px 12px -6px rgba(16,24,40,.08);
        }

        /* One entrance moment: the stat cards rise in a short stagger */
        @@keyframes riseIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: none; }
        }

        .rise-in {
            animation: riseIn .4s ease both;
        }

        /* ===== Banner ===== */
        .dash-banner {
            background: linear-gradient(120deg, var(--cm-accent, #090650) 0%, #171085 58%, #2b1fb0 100%);
            border: none;
            border-radius: 22px;
            color: #fff;
            overflow: hidden;
            position: relative;
            box-shadow: 0 18px 36px -20px rgba(9,6,80,.6);
        }

            .dash-banner::before {
                content: '';
                position: absolute;
                width: 280px;
                height: 280px;
                top: -120px;
                right: -60px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(255,255,255,.16), rgba(255,255,255,0) 70%);
                pointer-events: none;
            }

            .dash-banner .card-body {
                position: relative;
                z-index: 1;
                padding: 24px 26px;
                gap: 18px;
                justify-content: space-between;
            }

            .dash-banner h4 {
                color: #fff;
                font-weight: 700;
                font-size: 1.45rem;
                letter-spacing: .1px;
                margin-bottom: 4px;
            }

            .dash-banner p {
                color: rgba(255,255,255,.78);
                font-size: .92rem;
                margin: 0;
            }

            .dash-banner .wave {
                display: inline-block;
                transform-origin: 70% 70%;
                animation: wave 2.4s ease-in-out 2;
            }

        @@keyframes wave {
            0%, 60%, 100% { transform: rotate(0); }
            10%, 30% { transform: rotate(14deg); }
            20% { transform: rotate(-8deg); }
            40% { transform: rotate(-4deg); }
            50% { transform: rotate(10deg); }
        }

        .dash-banner-copy {
            min-width: 0;
        }

        .dash-banner-tools {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 12px;
        }

        .dash-banner-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .dash-badge {
            display: inline-flex;
            align-items: center;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.24);
            color: #fff;
            font-size: .8rem;
            font-weight: 600;
            padding: 8px 13px;
            border-radius: 12px;
            white-space: nowrap;
        }

        .dash-banner .btn-settings {
            display: inline-flex;
            align-items: center;
            background: #fff;
            border: 1px solid #fff;
            color: var(--cm-accent-ink, #090650);
            border-radius: 12px;
            padding: 8px 16px;
            font-weight: 700;
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .dash-banner .btn-settings:hover {
                box-shadow: 0 8px 18px rgba(10,8,70,.28);
                transform: translateY(-1px);
            }

        .dash-filter-bar {
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.24);
            border-radius: 14px;
            padding: 8px 11px;
            gap: 8px;
        }

        .dash-filter-label {
            font-size: .85rem;
            font-weight: 700;
            color: rgba(255,255,255,.9);
            white-space: nowrap;
        }

        .dash-filter-select {
            font-size: .85rem !important;
            font-weight: 600;
            border-radius: 10px !important;
            width: auto !important;
            max-width: 160px !important;
            flex: 0 0 auto;
            border-color: rgba(255,255,255,.35) !important;
        }

        .js-custom-range-btn {
            font-size: .82rem;
            font-weight: 600;
            border-radius: 10px;
            color: #fff !important;
            border-color: rgba(255,255,255,.5) !important;
        }

        .dash-range-pill {
            font-size: .78rem;
            font-weight: 700;
            background: rgba(255,255,255,.16);
            color: #fff;
            padding: 7px 12px;
            border-radius: 999px;
            white-space: nowrap;
        }

        /* ===== Section headings ===== */
        .section-head {
            display: flex;
            align-items: baseline;
            gap: 10px;
            margin: 6px 0 12px;
        }

        .section-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--d-ink, #090650);
            margin: 0;
        }

        .section-hint {
            font-size: .8rem;
            color: var(--d-muted, #6b7280);
        }

        /* ===== Main stat cards ===== */
        .stat-card {
            --accent: var(--cm-accent-ink, #090650);
            --soft: var(--cm-soft, #eef1fb);
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
            padding: 13px;
            background:
                radial-gradient(circle at 100% 0%, var(--soft), transparent 58%),
                var(--d-surface, #fff);
            border: 1px solid var(--d-border, #e6e9f2);
            border-radius: var(--d-radius);
            box-shadow: var(--d-shadow);
            cursor: pointer;
            overflow: hidden;
            transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
        }

            .stat-card::before {
                content: '';
                position: absolute;
                left: 0;
                top: 14px;
                bottom: 14px;
                width: 4px;
                border-radius: 0 4px 4px 0;
                background: var(--accent);
            }

            .stat-card:hover,
            .stat-card:focus-visible {
                transform: translateY(-4px);
                border-color: var(--accent);
                box-shadow: 0 18px 30px -16px var(--accent);
                outline: none;
            }

            .stat-card:focus-visible {
                box-shadow: 0 0 0 3px var(--soft), 0 18px 30px -16px var(--accent);
            }

            .stat-card .stat-ico {
                flex: 0 0 54px;
                width: 54px;
                height: 54px;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.25rem;
                background: var(--soft);
                color: var(--accent);
                margin-right: 14px;
                transition: transform .22s ease;
            }

            .stat-card:hover .stat-ico {
                transform: rotate(-6deg) scale(1.07);
            }

            .stat-card .stat-body {
                min-width: 0;
                flex: 1 1 auto;
            }

            .stat-card .stat-val {
                font-size: 1.55rem;
                font-weight: 700;
                color: var(--d-ink, #090650);
                line-height: 1.15;
                font-variant-numeric: tabular-nums;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                transition: opacity .2s ease;
            }

            .stat-card .stat-cur {
                font-size: .78rem;
                font-weight: 600;
                color: var(--d-muted, #6b7280);
                margin-right: 3px;
            }

            .stat-card .stat-lbl {
                font-size: .84rem;
                font-weight: 600;
                color: var(--d-muted, #6b7280);
                margin-top: 3px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .stat-card .stat-more {
                font-size: .72rem;
                font-weight: 600;
                color: var(--accent);
                margin-top: 6px;
                opacity: 0;
                transform: translateY(2px);
                transition: opacity .2s ease, transform .2s ease;
            }

            .stat-card:hover .stat-more,
            .stat-card:focus-visible .stat-more {
                opacity: 1;
                transform: none;
            }

            .stat-card .stat-arrow {
                flex: 0 0 28px;
                width: 28px;
                height: 28px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: .7rem;
                margin-left: 10px;
                background: var(--soft);
                color: var(--accent);
                transition: transform .22s ease;
            }

            .stat-card:hover .stat-arrow {
                transform: translateX(3px);
            }

        /* ===== Chart cards ===== */
        .chart-card {
            background: var(--d-surface, #fff);
            border: 1px solid var(--d-border, #e6e9f2);
            border-radius: var(--d-radius);
            box-shadow: var(--d-shadow);
            overflow: hidden;
        }

        .chart-card-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 6px;
            padding: 18px 20px 4px;
        }

        .chart-title {
            font-size: .98rem;
            font-weight: 700;
            color: var(--d-ink, #090650);
        }

        .chart-sub {
            font-size: .78rem;
            color: var(--d-muted, #6b7280);
            margin-top: 2px;
        }

        .chart-pill {
            font-size: .72rem;
            background: var(--d-soft, #eef1fb);
            color: var(--d-ink, #090650);
            padding: 5px 11px;
            border-radius: 999px;
            font-weight: 600;
            white-space: nowrap;
        }

        .chart-body {
            padding: 8px 18px 18px;
        }

        .chart-canvas {
            position: relative;
            height: 255px;
        }

            .chart-canvas.chart-canvas--donut {
                height: 265px;
            }

        /* Friendly message shown over a chart that has nothing to plot */
        .chart-empty {
            position: absolute;
            inset: 0;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 6px;
            text-align: center;
            padding: 0 24px;
            color: var(--d-muted, #6b7280);
            font-size: .85rem;
            pointer-events: none;
        }

            .chart-empty i {
                font-size: 1.6rem;
                opacity: .45;
            }

            .chart-empty.is-visible {
                display: flex;
            }

        /* Soft dimming while a new date range loads */
        .dash-data.is-loading .stat-val,
        .dash-data.is-loading .chart-canvas canvas {
            opacity: .35;
            transition: opacity .2s ease;
        }

        /* ===== Settings panel ===== */
        .settings-intro {
            font-size: .82rem;
            color: var(--cm-text-muted, #6b7280);
            padding: 0 16px 8px;
            margin: 0;
        }

        /* ===== Banner extras ===== */
        .dash-banner::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.14) 1.2px, transparent 1.4px);
            background-size: 18px 18px;
            -webkit-mask-image: linear-gradient(100deg, transparent 35%, #000 100%);
            mask-image: linear-gradient(100deg, transparent 35%, #000 100%);
            pointer-events: none;
        }

        .dash-avatar {
            position: relative;
            flex: 0 0 62px;
            width: 62px;
            height: 62px;
            margin-right: 16px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--cm-accent-ink, #090650);
            background: linear-gradient(145deg, #ffffff, #dfe3ff);
            box-shadow: 0 10px 22px -8px rgba(0,0,0,.45), 0 0 0 4px rgba(255,255,255,.18);
            transform: rotate(-4deg);
        }

        .dash-avatar-dot {
            position: absolute;
            right: -3px;
            bottom: -3px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #22c55e;
            border: 3px solid #2b1fb0;
        }

        .dash-banner .dash-banner-text p {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
        }

        .dash-filter-bar {
            border-radius: 999px;
            padding: 6px 8px 6px 14px;
            background: rgba(255,255,255,.14);
        }

        .dash-filter-select {
            border-radius: 999px !important;
            padding-left: 12px;
        }

        .dash-badge {
            border-radius: 999px;
            padding: 8px 15px;
        }

        .dash-banner .btn-settings {
            border-radius: 999px;
            padding: 8px 18px;
        }

        @@media (max-width: 575.98px) {
            .dash-avatar { flex-basis: 48px; width: 48px; height: 48px; font-size: 1.2rem; border-radius: 16px; margin-right: 12px; }
        }

        /* Breathing room in the banner */
        .dash-banner .card-body {
            padding: 28px 32px;
        }

        .dash-avatar {
            flex: 0 0 58px;
            width: 58px;
            height: 58px;
            margin: 4px 22px 4px 4px;
            box-shadow: 0 10px 20px -8px rgba(0,0,0,.45);
        }

        .dash-banner .dash-banner-text h4 {
            margin-bottom: 10px;
        }

        .dash-banner .wave {
            margin-left: 6px;
        }

        .dash-banner .dash-banner-text p {
            gap: 6px;
        }

        @@media (max-width: 575.98px) {
            .dash-banner .card-body { padding: 20px 18px; }
            .dash-avatar { flex-basis: 46px; width: 46px; height: 46px; margin: 2px 14px 2px 2px; }
        }

        /* Filter sits at the far right of the banner */
        .dash-banner-tools {
            flex: 1 1 auto;
            justify-content: flex-end;
        }

        .dash-banner-actions { order: 1; }
        .dash-filter-bar { order: 2; margin-left: auto; }

        @@media (max-width: 767.98px) {
            .dash-banner-tools { justify-content: flex-start; }
            .dash-filter-bar { margin-left: 0; }
        }

        @@media (max-width: 767.98px) {
            .dash-filter-bar { justify-content: flex-start; }
            .dash-range-pill { margin-left: 0 !important; }
        }

        @@media (max-width: 575.98px) {
            .dash-banner .card-body { gap: 12px; padding: 18px 16px; }
            .dash-banner h4 { font-size: 1.15rem; }
            .dash-banner-actions { gap: 7px; }
            .dash-banner-tools { justify-content: flex-start; gap: 8px; }
            .stat-card .stat-val { font-size: 1.3rem; }
            .chart-canvas, .chart-canvas.chart-canvas--donut { height: 230px; }
            .stat-card .stat-more { opacity: 1; transform: none; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .rise-in, .dash-banner .wave { animation: none; }
            .stat-card, .stat-card * { transition: none !important; }
        }
    </style>
}

<div class="dash">
    <!-- Welcome banner -->
    <div class="card dash-banner mb-3">
        <div class="card-body d-flex flex-row align-items-center justify-content-between flex-wrap">
            <div class="dash-banner-copy d-flex align-items-center">
                <div class="dash-avatar" aria-hidden="true">@initial<span class="dash-avatar-dot"></span></div>
                <div class="dash-banner-text">
                    <h4><span data-i18n="dash_welcome_back">Welcome back,</span> @fullName <span class="wave" aria-hidden="true">👋</span></h4>
                    <p>
                        <span data-i18n="dash_snapshot_for">Here is your POS snapshot for</span>
                        <span><i class="far fa-calendar-alt mr-1"></i>@today.ToString("dddd, dd MMMM yyyy")</span>
                    </p>
                </div>
            </div>
            <div class="dash-banner-tools">
                <div class="dash-filter-bar d-flex align-items-center flex-wrap">
                    <label class="dash-filter-label mb-0" for="dashRangeSelect"><i class="fas fa-filter mr-1"></i> <span data-i18n="dash_showing">Showing</span></label>
                    <select id="dashRangeSelect" class="form-control form-control-sm dash-filter-select js-range-select">
                        <option value="today" data-i18n="dash_range_today" selected>Today</option>
                        <option value="yesterday" data-i18n="dash_range_yesterday">Yesterday</option>
                        <option value="lastweek" data-i18n="dash_range_lastweek">Last Week</option>
                        <option value="thisweek" data-i18n="dash_range_thisweek">This Week</option>
                        <option value="lastmonth" data-i18n="dash_range_lastmonth">Last Month</option>
                        <option value="thismonth" data-i18n="dash_range_thismonth">This Month</option>
                        <option value="alltime" data-i18n="dash_range_alltime">All Time</option>
                        <option value="custom" data-i18n="dash_range_custom">Custom Date</option>
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-light js-custom-range-btn" style="display:none;" title="Pick a custom date range">
                        <i class="fas fa-calendar-week mr-1"></i> <span class="js-custom-range-label" data-i18n="dash_pick_dates">Pick dates</span>
                    </button>
                    <span class="dash-range-pill js-range-pill" aria-live="polite"><i class="fas fa-clock mr-1"></i> Today</span>
                </div>
                <div class="dash-banner-actions">
                    <span class="dash-badge"><i class="fas fa-user-shield mr-2"></i> @(Session["Role"] != null ? Session["Role"].ToString() : "User")</span>
                    <button type="button" class="btn btn-settings" data-widget="control-sidebar" data-controlsidebar-slide="true" title="Choose which cards to show">
                        <i class="fas fa-sliders-h mr-1"></i> <span data-i18n="dash_settings_btn">Settings</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="dash-data" id="dashData">

        <!-- Main stat cards -->
        <div class="section-head">
            <h5 class="section-title"><i class="fas fa-th-large mr-1"></i> Overview</h5>
            <span class="section-hint">Select a card to open its report</span>
        </div>

        <div class="row">
            @for (var i = 0; i < cards.Count; i++)
            {
                var card = cards[i];
                var theme = themes.ContainsKey(card.CardID) ? themes[card.CardID] : themes[1];
                var isMoney = moneyIds.Contains(card.CardID);
                <div class="col-xl-3 col-lg-4 col-sm-6 mb-3 d-flex rise-in" style="animation-delay:@((i * 60))ms">
                    <div class="stat-card card-clickable" data-card-id="@card.CardID" data-card-title="@card.Title"
                         role="button" tabindex="0" aria-label="@card.Title - open details"
                         style="--accent:@theme[0]; --soft:@theme[1];">
                        <div class="stat-ico"><i class="@card.Icon"></i></div>
                        <div class="stat-body">
                            <div class="stat-val">
                                @if (isMoney)
                                {
                                    <span class="stat-cur">Rs.</span>
                                }@card.Value
                            </div>
                            <div class="stat-lbl" data-i18n="@(cardI18nKeys.ContainsKey(card.CardID) ? cardI18nKeys[card.CardID] : null)">@card.Title</div>
                            <div class="stat-more">View details</div>
                        </div>
                        <span class="stat-arrow" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
                    </div>
                </div>
            }
            @if (cards.Count == 0)
            {
                <div class="col-12">
                    <div class="alert alert-light border mb-0">
                        <i class="fas fa-info-circle mr-2"></i> No cards are showing yet. Open <strong>Settings</strong> and switch on the cards you want to see.
                    </div>
                </div>
            }
        </div>

        @* Analytics charts *@
        <div class="section-head">
            <h5 class="section-title"><i class="fas fa-chart-pie mr-1"></i> <span data-i18n="dash_analytics">Analytics</span></h5>
            <span class="section-hint">Hover over a chart to see exact amounts</span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="chart-card h-100">
                    <div class="chart-card-header">
                        <div>
                            <div class="chart-title" data-i18n="dash_sales_profit_title">Sales &amp; Profit</div>
                            <div class="chart-sub js-trend-sub">Today's performance</div>
                        </div>
                        <span class="chart-pill js-trend-pill"><i class="fas fa-calendar-week mr-1"></i> Today</span>
                    </div>
                    <div class="chart-body">
                        <div class="chart-canvas">
                            <canvas id="salesProfitChart"></canvas>
                            <div class="chart-empty"><i class="fas fa-chart-bar"></i><span>No sales in this period yet.</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="chart-card h-100">
                    <div class="chart-card-header">
                        <div>
                            <div class="chart-title" data-i18n="dash_monthly_sales_title">Monthly Sales</div>
                            <div class="chart-sub" data-i18n="dash_monthly_sales_sub">Last 6 months revenue</div>
                        </div>
                        <span class="chart-pill"><i class="fas fa-calendar-alt mr-1"></i> 6 Months</span>
                    </div>
                    <div class="chart-body">
                        <div class="chart-canvas">
                            <canvas id="monthlySalesChart"></canvas>
                            <div class="chart-empty"><i class="fas fa-chart-line"></i><span>Monthly sales will appear after your first sale.</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row d-flex">
            <div class="col-md-6 mb-3">
                <div class="chart-card h-100">
                    <div class="chart-card-header">
                        <div>
                            <div class="chart-title" data-i18n="dash_top_products_title">Top Products</div>
                            <div class="chart-sub js-top-products-sub">Best sellers - Today</div>
                        </div>
                        <span class="chart-pill"><i class="fas fa-medal mr-1"></i> <span data-i18n="dash_top5">Top 5</span></span>
                    </div>
                    <div class="chart-body">
                        <div class="chart-canvas chart-canvas--donut">
                            <canvas id="topProductsChart"></canvas>
                            <div class="chart-empty"><i class="fas fa-pills"></i><span>No products sold in this period.</span></div>
                        </div>
                    </div>
                </div>
            </div>

            @* Inventory health - side by side with Top Products *@
            <div class="col-md-6 mb-3">
                <div class="chart-card h-100">
                    <div class="chart-card-header">
                        <div>
                            <div class="chart-title" data-i18n="dash_inventory_health_title">Inventory Health</div>
                            <div class="chart-sub" data-i18n="dash_inventory_health_sub">Total products vs. low stock &amp; expiring soon</div>
                        </div>
                        <span class="chart-pill"><i class="fas fa-capsules mr-1"></i> <span data-i18n="dash_live">Live</span></span>
                    </div>
                    <div class="chart-body">
                        <div class="chart-canvas chart-canvas--donut">
                            <canvas id="inventoryHealthChart"></canvas>
                            <div class="chart-empty"><i class="fas fa-box-open"></i><span>No inventory data to show yet.</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Sidebar options cards and graphs configuration *@
    <aside class="control-sidebar control-sidebar-light" style="display: none;">

        <button type="button" class="close float-left mb-2 js-close-sidebar btn-default" aria-label="Close settings" style="font-size: 24px;border: none;background: darkgrey;border-radius: 20px;padding: 0px 5px 0px 5px;margin-left: -13px;">
            &times;
        </button>

        <div class="p-3 control-sidebar-content">
            <h5 class="text-center pt-3 primary-text font-weight-bold" data-i18n="dash_settings_title">Dashboard Setting</h5>
            <hr class="mb-2">
            <h6 class="ml-3" data-i18n="dash_cards_options">Cards Options</h6>
            <p class="settings-intro">Switch a card on to show it on your dashboard. Press <strong>Update Settings</strong> to save.</p>

            <table class="table" id="dashboardSettingsTable">
                <tbody>
                    @if (isUpdate)
                    {
                        foreach (var card in Model.DashboardSettings)
                        {
                            <tr>
                                <td data-i18n="@(cardI18nKeys.ContainsKey(card.CardID) ? cardI18nKeys[card.CardID] : null)">@card.Title</td>
                                <td>
                                    <div class="checkbox-wrapper">
                                        <input class="switch pull-right" type="checkbox" name="IsVisible" checked="@card.IsVisible" aria-label="Show @card.Title" />
                                    </div>
                                </td>
                                <td>
                                    <input type="hidden" name="Title" value="@card.Title" />
                                    <input type="hidden" name="CardID" value="@card.CardID" />
                                    <input type="hidden" name="Order" value="@card.Order" />
                                    <input type="hidden" name="ID" value="@card.ID" />
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        foreach (var card in DashBoardCards)
                        {
                            <tr>
                                <td data-i18n="@(cardI18nKeys.ContainsKey(card.CardID) ? cardI18nKeys[card.CardID] : null)">@card.Title</td>
                                <td>
                                    <div class="checkbox-wrapper">
                                        <input class="switch pull-right" type="checkbox" name="IsVisible" checked aria-label="Show @card.Title" />
                                    </div>
                                </td>
                                <td>
                                    <input type="hidden" name="Title" value="@card.Title" />
                                    <input type="hidden" name="CardID" value="@card.CardID" />
                                    <input type="hidden" name="Order" value="0" />
                                    <input type="hidden" name="ID" value="0" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div style="margin: 8px 40px 16px; display: flex; justify-content: center;">
                <button type="submit" class="btn btn-block btn-primary btn-sm js-save-btn" data-i18n="dash_update_settings_btn">Update Settings</button>
            </div>
        </div>
    </aside>
</div>

@section Scripts{
    <script>

        var SaveDashBoardSettingUrl = '@Url.Action("SaveDashBoardSetting", "DashBoard")';
        var GetDashboardDataUrl = '@Url.Action("GetDashboardData", "DashBoard")';
        var reportSaleUrl = '@Url.Action("SaleReport", "Reports")';
        var saleInvoicesUrl = '@Url.Action("SaleInvoices", "Sales")';
        var profitMarginReportUrl = '@Url.Action("ProfitMarginReport", "Reports")';
        var dailySalesReportUrl = '@Url.Action("DailySalesReport", "Reports")';
        var stockValuationReportUrl = '@Url.Action("StockValuationReport", "Reports")';
        var inventoryItemsUrl = '@Url.Action("Items", "InventoryItems")';
        var customerLedgerUrl = '@Url.Action("CustomerLedger", "Reports")';
        var expiryReportUrl = '@Url.Action("ExpiryReport", "Reports")';
        var itemWiseSaleReportUrl = '@Url.Action("ItemWiseSaleReport", "Reports")';
        var customerOutstandingReportUrl = '@Url.Action("CustomerOutstandingReport", "Reports")';

        // Date range currently shown on the dashboard (yyyy-MM-dd). Card clicks pass it to
        // date-based reports; refreshed whenever the range filter changes.
        window.dashboardRange = { from: '@today.ToString("yyyy-MM-dd")', to: '@today.ToString("yyyy-MM-dd")' };

    </script>
    <script src="~/JSModels/DashBoard/dashBoardSetting.js"></script>
    <script src="~/panel-assets/plugins/DateRange/moment.min.js"></script>
    @* Re-include after moment.min.js: the global copy in _Layout.cshtml loads before moment exists
       on any page, so it silently binds to a broken moment reference. Re-running it here (same
       pattern used by Views/Reports/*.cshtml) re-registers a working $.fn.daterangepicker. *@
    <script src="~/panel-assets/plugins/DateRange/daterangepicker.js"></script>
    <script>
        var dashCharts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Charts ?? new HARTPOS.Models.DashBoard.DashboardChartsDto()));

        (function ($) {
            // Keyboard support: Enter / Space on a focused card behaves like a click
            $(document).on('keydown', '.stat-card', function (e) {
                if (e.which === 13 || e.which === 32) {
                    e.preventDefault();
                    $(this).trigger('click');
                }
            });

            if (typeof Chart === 'undefined') { return; }

            var MONEY_CARD_IDS = [1, 3, 5, 7, 8];
            var RANGE_LABELS = {
                today: 'Today', yesterday: 'Yesterday', thisweek: 'This Week', lastweek: 'Last Week',
                thismonth: 'This Month', lastmonth: 'Last Month', custom: 'Custom Range', alltime: 'All Time'
            };

            var palette = ['#090650', '#2563eb', '#16a34a', '#7c3aed', '#0d9488', '#f59e0b', '#dc2626'];
            var gridColor = '#eef1f7';
            var tickColor = '#8a90a2';
            var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            var trendChart = null;
            var topProductsChartInstance = null;
            var inventoryHealthChartInstance = null;

            function moneyLabel(value) {
                return 'Rs. ' + (Number(value) || 0).toLocaleString();
            }

            function shortDate(value) {
                if (!value) { return ''; }
                var parts = String(value).substring(0, 10).split('-');
                if (parts.length !== 3) { return value; }
                return parts[2] + ' ' + monthNames[parseInt(parts[1], 10) - 1];
            }

            function monthLabel(value) {
                if (!value) { return ''; }
                var parts = String(value).split('-');
                if (parts.length !== 2) { return value; }
                return monthNames[parseInt(parts[1], 10) - 1] + " '" + parts[0].substring(2);
            }

            function trendLabel(point, granularity) {
                if (granularity === 'year') { return point.Date; }
                if (granularity === 'month') { return monthLabel(point.Date); }
                return shortDate(point.Date);
            }

            function legendLabels() {
                return { usePointStyle: true, boxWidth: 8, padding: 14, fontColor: '#5b6478', fontSize: 11 };
            }

            // Shows or hides the friendly "nothing to show" message on top of a chart
            function toggleEmpty(canvasId, isEmpty) {
                var el = document.getElementById(canvasId);
                if (!el) { return; }
                $(el).closest('.chart-canvas').find('.chart-empty').toggleClass('is-visible', !!isEmpty);
            }

            function hasAnyValue(list) {
                return (list || []).some(function (v) { return Number(v) > 0; });
            }

            function renderTrendChart(daily, granularity) {
                var el = document.getElementById('salesProfitChart');
                if (!el) { return; }

                var labels = daily.map(function (d) { return trendLabel(d, granularity); });
                var sales = daily.map(function (d) { return d.SaleAmount; });
                var profit = daily.map(function (d) { return d.ProfitAmount; });

                toggleEmpty('salesProfitChart', !hasAnyValue(sales) && !hasAnyValue(profit));

                if (trendChart) {
                    trendChart.data.labels = labels;
                    trendChart.data.datasets[0].data = sales;
                    trendChart.data.datasets[1].data = profit;
                    trendChart.update();
                    return;
                }

                trendChart = new Chart(el.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Sales', data: sales,
                                backgroundColor: 'rgba(9,6,80,.85)', borderColor: '#090650',
                                borderWidth: 0, borderRadius: 5, barPercentage: 0.55, categoryPercentage: 0.72
                            },
                            {
                                label: 'Profit', data: profit,
                                backgroundColor: 'rgba(22,163,74,.85)', borderColor: '#16a34a',
                                borderWidth: 0, borderRadius: 5, barPercentage: 0.55, categoryPercentage: 0.72
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { position: 'bottom', labels: legendLabels() },
                        tooltips: {
                            mode: 'index',
                            intersect: false,
                            backgroundColor: '#0f172a',
                            callbacks: {
                                label: function (tooltipItem, data) {
                                    return data.datasets[tooltipItem.datasetIndex].label + ': ' + moneyLabel(tooltipItem.yLabel);
                                }
                            }
                        },
                        scales: {
                            xAxes: [{ gridLines: { display: false }, ticks: { fontColor: tickColor, fontSize: 11 } }],
                            yAxes: [{
                                beginAtZero: true,
                                gridLines: { color: gridColor, drawBorder: false },
                                ticks: { fontColor: tickColor, fontSize: 11, callback: function (value) { return Number(value).toLocaleString(); } }
                            }]
                        }
                    }
                });
            }

            function renderDonut(labels, values) {
                var el = document.getElementById('topProductsChart');
                if (!el) { return; }

                var hasData = labels.length > 0 && values.some(function (v) { return Number(v) > 0; });
                var showLabels = hasData ? labels : ['No data yet'];
                var showValues = hasData ? values : [1];
                var showColors = hasData
                    ? labels.map(function (unused, i) { return palette[i % palette.length]; })
                    : ['#e6e9f2'];

                toggleEmpty('topProductsChart', !hasData);

                if (topProductsChartInstance) {
                    topProductsChartInstance.destroy();
                }

                topProductsChartInstance = new Chart(el.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: showLabels,
                        datasets: [{ data: showValues, backgroundColor: showColors, borderWidth: 2, borderColor: '#fff' }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutoutPercentage: 62,
                        legend: { position: 'bottom', labels: legendLabels() },
                        tooltips: {
                            enabled: hasData,
                            backgroundColor: '#0f172a',
                            callbacks: {
                                label: function (tooltipItem, data) {
                                    return data.labels[tooltipItem.index] + ': ' + moneyLabel(data.datasets[0].data[tooltipItem.index]);
                                }
                            }
                        }
                    }
                });
            }

            function renderMonthlyChart(monthly) {
                var monthlyCtx = document.getElementById('monthlySalesChart');
                if (!monthlyCtx) { return; }

                var ctx2d = monthlyCtx.getContext('2d');
                var grad = ctx2d.createLinearGradient(0, 0, 0, 255);
                grad.addColorStop(0, 'rgba(37,99,235,.32)');
                grad.addColorStop(1, 'rgba(37,99,235,0)');

                toggleEmpty('monthlySalesChart', !hasAnyValue(monthly.map(function (m) { return m.Value; })));

                new Chart(ctx2d, {
                    type: 'line',
                    data: {
                        labels: monthly.map(function (m) { return monthLabel(m.Label); }),
                        datasets: [{
                            label: 'Revenue',
                            data: monthly.map(function (m) { return m.Value; }),
                            borderColor: '#2563eb',
                            backgroundColor: grad,
                            borderWidth: 2.5,
                            fill: true,
                            lineTension: 0.35,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#2563eb',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { position: 'bottom', labels: legendLabels() },
                        tooltips: {
                            mode: 'index',
                            intersect: false,
                            backgroundColor: '#0f172a',
                            callbacks: { label: function (tooltipItem) { return 'Revenue: ' + moneyLabel(tooltipItem.yLabel); } }
                        },
                        scales: {
                            xAxes: [{ gridLines: { display: false }, ticks: { fontColor: tickColor, fontSize: 11 } }],
                            yAxes: [{
                                beginAtZero: true,
                                gridLines: { color: gridColor, drawBorder: false },
                                ticks: { fontColor: tickColor, fontSize: 11, callback: function (value) { return Number(value).toLocaleString(); } }
                            }]
                        }
                    }
                });
            }

            function renderInventoryHealthChart(items) {
                var el = document.getElementById('inventoryHealthChart');
                if (!el) { return; }

                items = items || [];
                var colors = ['#0d9488', '#f59e0b', '#dc2626'];

                toggleEmpty('inventoryHealthChart', !hasAnyValue(items.map(function (i) { return i.Value; })));

                if (inventoryHealthChartInstance) {
                    inventoryHealthChartInstance.destroy();
                }

                inventoryHealthChartInstance = new Chart(el.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: items.map(function (i) { return i.Label; }),
                        datasets: [{
                            data: items.map(function (i) { return i.Value; }),
                            backgroundColor: items.map(function (i, idx) { return colors[idx % colors.length]; }),
                            borderWidth: 0,
                            borderRadius: 6,
                            barPercentage: 0.5,
                            categoryPercentage: 0.6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        legend: { display: false },
                        tooltips: {
                            backgroundColor: '#0f172a',
                            callbacks: { label: function (tooltipItem) { return Number(tooltipItem.yLabel).toLocaleString(); } }
                        },
                        scales: {
                            xAxes: [{ gridLines: { display: false }, ticks: { fontColor: tickColor, fontSize: 11 } }],
                            yAxes: [{
                                beginAtZero: true,
                                gridLines: { color: gridColor, drawBorder: false },
                                ticks: { fontColor: tickColor, fontSize: 11, precision: 0 }
                            }]
                        }
                    }
                });
            }

            function renderCards(cards) {
                // Labels are static per CardID and already translated via data-i18n - only the
                // value changes with the date range, so only touch .stat-val here.
                (cards || []).forEach(function (c) {
                    var $card = $('.stat-card[data-card-id="' + c.CardID + '"]');
                    if (!$card.length) { return; }
                    var isMoney = MONEY_CARD_IDS.indexOf(c.CardID) > -1;
                    $card.find('.stat-val').html((isMoney ? '<span class="stat-cur">Rs.</span>' : '') + c.Value);
                });
            }

            function applyDashboardData(data, rangeKey) {
                renderCards(data.Cards);
                if (data.FromDate && data.ToDate) {
                    window.dashboardRange = { from: data.FromDate, to: data.ToDate };
                }

                var i18n = window.HARTPOSI18n;
                var translated = i18n ? i18n.t('dash_range_' + rangeKey) : null;
                var label = translated || data.RangeLabel || RANGE_LABELS[rangeKey] || 'Today';
                $('.js-range-pill').html('<i class="fas fa-clock mr-1"></i> ' + label);
                $('.js-trend-sub').text((rangeKey === 'today' ? "Today's" : label) + ' performance');
                $('.js-trend-pill').html('<i class="fas fa-calendar-week mr-1"></i> ' + label);
                $('.js-top-products-sub').text('Best sellers - ' + label);

                var charts = data.Charts || {};
                renderTrendChart(charts.DailySales || [], charts.TrendGranularity || 'day');
                renderInventoryHealthChart(charts.InventoryHealth || []);

                var topProducts = charts.TopProducts || [];
                renderDonut(
                    topProducts.map(function (p) { return p.Label; }),
                    topProducts.map(function (p) { return p.Value; }));
            }

            function refreshDashboard(rangeKey, fromMoment, toMoment) {
                var payload = { Range: rangeKey };
                var $data = $('#dashData');

                if (rangeKey === 'custom') {
                    payload.FromDate = fromMoment.format('YYYY-MM-DD');
                    payload.ToDate = toMoment.format('YYYY-MM-DD');
                }

                $data.addClass('is-loading');
                $('.js-range-pill').html('<i class="fas fa-spinner fa-spin mr-1"></i> Loading...');

                $.post(GetDashboardDataUrl, payload)
                    .done(function (resp) {
                        if (!resp || !resp.Status || !resp.Data) {
                            toastr.error((resp && resp.Message) || 'Could not load that date range.', '', { timeOut: 2000 });
                            return;
                        }
                        applyDashboardData(resp.Data, rangeKey);
                    })
                    .fail(function () {
                        toastr.error('Could not refresh the dashboard. Please check your connection and try again.', '', { timeOut: 2500 });
                    })
                    .always(function () {
                        $data.removeClass('is-loading');
                    });
            }

            $(function () {
                if (typeof moment === 'undefined' || !$.fn.daterangepicker) { return; }

                var today = moment();
                var $select = $('.js-range-select');
                var $customBtn = $('.js-custom-range-btn');
                var $customLabel = $('.js-custom-range-label');
                var previousValue = $select.val();

                // Hosts the calendar; only ever opened when "Custom Date" is picked from the dropdown.
                $customBtn.daterangepicker({
                    opens: 'left',
                    autoApply: false,
                    startDate: today.clone(),
                    endDate: today.clone(),
                    locale: { format: 'MM/DD/YYYY' }
                }, function (start, end) {
                    previousValue = 'custom';
                    $customLabel.text(start.format('MM/DD/YYYY') + ' - ' + end.format('MM/DD/YYYY'));
                    refreshDashboard('custom', start, end);
                });

                $customBtn.on('cancel.daterangepicker', function () {
                    // Cancelled without applying: fall back to whatever was selected before.
                    $select.val(previousValue);
                    $customBtn.toggle(previousValue === 'custom');
                });

                $select.on('change', function () {
                    var rangeKey = $(this).val();

                    if (rangeKey === 'custom') {
                        $customBtn.show();
                        $customBtn.data('daterangepicker').show();
                        return;
                    }

                    previousValue = rangeKey;
                    $customBtn.hide();
                    refreshDashboard(rangeKey, null, null);
                });
            });

            if (dashCharts) {
                renderTrendChart(dashCharts.DailySales || [], dashCharts.TrendGranularity || 'day');
                renderInventoryHealthChart(dashCharts.InventoryHealth || []);

                var topProducts = dashCharts.TopProducts || [];
                renderDonut(
                    topProducts.map(function (p) { return p.Label; }),
                    topProducts.map(function (p) { return p.Value; }));

                renderMonthlyChart(dashCharts.MonthlySales || []);
            }
        })(jQuery);
    </script>
}
