<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - POS Terminal</title>
    @{
        string printLogo = HARTPOS.Repositories.BrandingsRepository.GetPrintLogoUrl();
    }
    @if (!string.IsNullOrWhiteSpace(printLogo))
    {
        <link rel="icon" type="image/png" href="@printLogo" />
        <link rel="shortcut icon" type="image/png" href="@printLogo" />
    }
    else
    {
        <link rel="icon" href="~/favicon.ico" />
    }
    <script>
        (function () {
            try {
                document.documentElement.setAttribute('data-theme', 'light');
            } catch (e) { }
        })();
    </script>
    <link href="~/assets/Fonts/font.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/AdminLTE/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/assets/AdminLTE/dist/css/adminlte.min.css">
    <link href="~/ReplacementPaths/Toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/Styles/Shared/layout.css" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --pos-ink: #0b1437;
            --pos-ink-2: #131f52;
            --pos-violet: #5b4bd6;
            --pos-green: #16a34a;
            --pos-green-2: #22c55e;
            --pos-green-soft: #e7f6ec;
            --pos-paper: #fffdf7;
            --pos-line: #e1e5f1;
            --pos-muted: #5d6474;
        }

        /* ---------- Backdrop: soft aurora ---------- */
        body.login-page {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(900px 500px at 8% 6%, rgba(91,75,214,.20), transparent 60%),
                radial-gradient(800px 500px at 96% 94%, rgba(34,197,94,.20), transparent 60%),
                radial-gradient(600px 420px at 85% 8%, rgba(244,114,182,.16), transparent 60%),
                #eef1fb;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 24px 16px;
            overflow-x: hidden;
            overflow-y: auto;
        }

            body.login-page::before,
            body.login-page::after {
                content: '';
                position: fixed;
                border-radius: 50%;
                filter: blur(60px);
                opacity: .55;
                pointer-events: none;
                z-index: 0;
                animation: drift 16s ease-in-out infinite alternate;
            }

            body.login-page::before {
                width: 340px;
                height: 340px;
                left: -90px;
                bottom: -80px;
                background: #a5b4fc;
            }

            body.login-page::after {
                width: 300px;
                height: 300px;
                right: -70px;
                top: -70px;
                background: #fbcfe8;
                animation-delay: -6s;
            }

        @@keyframes drift {
            from { transform: translate(0, 0) scale(1); }
            to { transform: translate(30px, -24px) scale(1.12); }
        }

        /* ---------- Terminal shell ---------- */
        .pos-terminal {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 1000px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: #fff;
            border-radius: 28px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.8);
            box-shadow:
                0 2px 4px rgba(11,20,55,.05),
                0 30px 70px -20px rgba(11,20,55,.35),
                0 0 0 8px rgba(255,255,255,.45);
            animation: terminalIn .6s cubic-bezier(.2,.8,.2,1);
        }

        @@keyframes terminalIn {
            from { opacity: 0; transform: translateY(20px) scale(.985); }
            to { opacity: 1; transform: none; }
        }

        /* ---------- Left: counter display ---------- */
        .pos-side {
            position: relative;
            overflow: hidden;
            color: #fff;
            padding: 32px 32px 0;
            display: flex;
            flex-direction: column;
            min-height: 580px;
            background:
                radial-gradient(420px 320px at 100% 0%, rgba(124,108,255,.55), transparent 65%),
                radial-gradient(380px 300px at 0% 100%, rgba(34,197,94,.32), transparent 65%),
                linear-gradient(160deg, var(--pos-ink) 0%, var(--pos-ink-2) 100%);
        }

            /* fine dotted texture */
            .pos-side::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: radial-gradient(rgba(255,255,255,.13) 1.2px, transparent 1.4px);
                background-size: 20px 20px;
                -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
                mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
                pointer-events: none;
            }

            .pos-side > * {
                position: relative;
                z-index: 1;
            }

        .pos-brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .pos-brand-icon {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            background: linear-gradient(145deg, rgba(255,255,255,.28), rgba(255,255,255,.06));
            border: 1px solid rgba(255,255,255,.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            box-shadow: 0 10px 24px -8px rgba(124,108,255,.8), inset 0 1px 0 rgba(255,255,255,.35);
            transform: rotate(-4deg);
        }

        .pos-brand h1 {
            font-size: 20px;
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: .2px;
        }

        .pos-brand p {
            font-size: 12.5px;
            color: #b4bee0;
        }

        .pos-status {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 24px;
        }

        .pos-chip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 12px;
            padding: 7px 13px;
            border-radius: 999px;
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.18);
            color: #e3e8ff;
            -webkit-backdrop-filter: blur(6px);
            backdrop-filter: blur(6px);
        }

        .pos-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #4ade80;
            box-shadow: 0 0 0 0 rgba(74,222,128,.6);
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            70% { box-shadow: 0 0 0 7px rgba(74,222,128,0); }
            100% { box-shadow: 0 0 0 0 rgba(74,222,128,0); }
        }

        .pos-clock {
            margin-top: 22px;
        }

            .pos-clock .time {
                font-size: 44px;
                font-weight: 700;
                letter-spacing: 1px;
                font-variant-numeric: tabular-nums;
                text-shadow: 0 0 28px rgba(165,180,252,.55);
            }

            .pos-clock .date {
                font-size: 13px;
                color: #b4bee0;
                margin-top: 2px;
            }

        /* Receipt strip */
        .pos-receipt-wrap {
            margin-top: auto;
            padding-top: 24px;
        }

        .pos-receipt {
            background: var(--pos-paper);
            color: #222;
            width: 100%;
            max-width: 300px;
            margin: 0 auto;
            padding: 16px 18px 28px;
            font-family: 'Courier New', Consolas, monospace;
            font-size: 12px;
            position: relative;
            border-radius: 8px 8px 0 0;
            box-shadow: 0 -10px 34px rgba(0,0,0,.32), 0 0 0 1px rgba(255,255,255,.4);
            transform: rotate(-1.5deg);
            transform-origin: bottom center;
            transition: transform .35s ease;
        }

            .pos-receipt:hover {
                transform: rotate(0) translateY(-4px);
            }

            .pos-receipt .r-title {
                text-align: center;
                font-weight: 700;
                font-size: 13px;
            }

            .pos-receipt .r-sub {
                text-align: center;
                color: #777;
                margin-bottom: 8px;
            }

            .pos-receipt hr {
                border: 0;
                border-top: 1px dashed #b9b6aa;
                margin: 8px 0;
            }

            .pos-receipt .r-row {
                display: flex;
                justify-content: space-between;
                gap: 8px;
                padding: 1px 0;
            }

            .pos-receipt .r-total {
                font-weight: 700;
                font-size: 13px;
            }

            .pos-receipt .r-barcode {
                height: 28px;
                margin-top: 10px;
                background: repeating-linear-gradient(90deg, #111 0 2px, transparent 2px 4px, #111 4px 5px, transparent 5px 8px, #111 8px 11px, transparent 11px 12px, #111 12px 13px, transparent 13px 16px);
            }

            .pos-receipt::after {
                content: '';
                position: absolute;
                left: 0;
                right: 0;
                bottom: -8px;
                height: 8px;
                background: linear-gradient(-45deg, transparent 6px, var(--pos-paper) 0) 0 0 / 12px 8px, linear-gradient(45deg, transparent 6px, var(--pos-paper) 0) 0 0 / 12px 8px;
                background-repeat: repeat-x;
            }

        /* ---------- Right: sign in ---------- */
        .pos-main {
            position: relative;
            overflow: hidden;
            padding: 44px 42px 26px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background:
                radial-gradient(320px 240px at 100% 0%, rgba(34,197,94,.10), transparent 70%),
                radial-gradient(300px 220px at 0% 100%, rgba(91,75,214,.08), transparent 70%),
                #fff;
        }

            .pos-main h2 {
                font-size: 27px;
                font-weight: 800;
                color: var(--pos-ink);
                letter-spacing: -.2px;
            }

            .pos-main .lead {
                font-size: 14.5px;
                color: var(--pos-muted);
                margin: 6px 0 28px;
            }

        .pos-field {
            margin-bottom: 20px;
        }

            .pos-field label {
                display: block;
                font-size: 13px;
                font-weight: 600;
                color: #2b3046;
                margin-bottom: 7px;
            }

        .login-label-ico {
            width: 16px;
            margin-right: 4px;
            color: var(--pos-violet);
        }

        .input-group {
            border-radius: 14px;
            overflow: hidden;
            border: 1.5px solid var(--pos-line);
            background: #f6f7fc !important;
            transition: border-color .2s, box-shadow .2s, background .2s;
            flex-wrap: nowrap;
        }

            .input-group:hover {
                border-color: #c9cfe6;
            }

            .input-group:focus-within {
                background: #fff !important;
                border-color: var(--pos-violet);
                box-shadow: 0 0 0 4px rgba(91,75,214,.14), 0 10px 22px -14px rgba(91,75,214,.6);
            }

            .input-group .form-control {
                border: none;
                height: 54px;
                padding: 12px 15px;
                font-size: 16px;
                background: transparent !important;
                color: #1f2437;
            }

                .input-group .form-control:focus {
                    box-shadow: none;
                    border: none;
                }

                .input-group .form-control::placeholder {
                    color: #a4a9b8;
                }

            .input-group .input-group-text {
                border: none;
                background: transparent !important;
                padding: 0 8px 0 16px;
                color: var(--pos-violet);
            }

        .btn-toggle-pass {
            background: transparent !important;
            border: none;
            color: var(--pos-ink-2);
            padding: 0 16px;
            height: 100%;
            font-size: 16px;
            cursor: pointer;
            outline: none;
            transition: color .15s;
        }

            .btn-toggle-pass:hover, .btn-toggle-pass:focus {
                color: var(--pos-green);
            }

        .btn-login {
            position: relative;
            overflow: hidden;
            width: 100%;
            height: 58px;
            border: none;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--pos-green-2) 0%, var(--pos-green) 55%, #0f8a3d 100%);
            color: #fff;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: .4px;
            cursor: pointer;
            margin-top: 8px;
            box-shadow: 0 14px 26px -10px rgba(22,163,74,.75), inset 0 1px 0 rgba(255,255,255,.3);
            transition: transform .18s, box-shadow .18s, filter .18s;
        }

            /* soft shine that sweeps across on hover */
            .btn-login::after {
                content: '';
                position: absolute;
                top: 0;
                left: -60%;
                width: 40%;
                height: 100%;
                background: linear-gradient(100deg, transparent, rgba(255,255,255,.35), transparent);
                transform: skewX(-18deg);
                transition: left .6s ease;
            }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 18px 30px -10px rgba(22,163,74,.85), inset 0 1px 0 rgba(255,255,255,.3);
                filter: saturate(1.08);
            }

                .btn-login:hover::after {
                    left: 120%;
                }

            .btn-login:active {
                transform: translateY(1px);
            }

            .btn-login:disabled {
                opacity: .7;
                cursor: not-allowed;
                transform: none;
            }

            .btn-login:focus-visible, .btn-toggle-pass:focus-visible {
                outline: 3px solid rgba(91,75,214,.4);
                outline-offset: 2px;
            }

        .pos-hints {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 22px;
            font-size: 12px;
            color: var(--pos-muted);
        }

            .pos-hints > * {
                display: inline-flex;
                align-items: center;
                padding: 6px 12px;
                border-radius: 999px;
                background: var(--pos-green-soft);
                color: #1f5f37;
            }

            .pos-hints i {
                color: var(--pos-green);
                margin-right: 6px;
            }

        .login-footer {
            margin-top: auto;
            padding-top: 24px;
            text-align: center;
            font-size: 12px;
            color: #98a0b3;
        }

        /* ---------- Responsive ---------- */
        @@media (max-width: 820px) {
            .pos-terminal {
                grid-template-columns: 1fr;
                max-width: 460px;
                border-radius: 24px;
                box-shadow: 0 24px 50px -20px rgba(11,20,55,.35), 0 0 0 6px rgba(255,255,255,.45);
            }

            .pos-side {
                min-height: 0;
                padding: 24px 22px 24px;
            }

            .pos-receipt-wrap, .pos-clock {
                display: none;
            }

            .pos-status {
                margin-top: 16px;
            }

            .pos-main {
                padding: 30px 22px 22px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .pos-terminal, .pos-dot, body.login-page::before, body.login-page::after {
                animation: none;
            }

            .pos-receipt, .btn-login, .btn-login::after {
                transition: none;
            }
        }
    </style>
    <link href="~/Styles/Shared/theme.css" rel="stylesheet" />
</head>
<body class="login-page">
    @RenderBody()

    <script src="~/assets/AdminLTE/plugins/jquery/jquery.min.js"></script>
    <script src="~/assets/AdminLTE/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/AdminLTE/plugins/jquery-validation/jquery.validate.min.js"></script>
    <script src="~/assets/AdminLTE/plugins/jquery-validation/additional-methods.min.js"></script>
    <script src="~/ReplacementPaths/Toastr/toastr.min.js"></script>
    @RenderSection("Scripts", false)
</body>
</html>
