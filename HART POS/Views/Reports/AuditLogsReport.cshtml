@{
    ViewBag.Title = "AuditLogsReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var actionList = ViewBag.Actions as List<string> ?? new List<string>();
    var usernameList = ViewBag.Usernames as List<string> ?? new List<string>();
}
@section Styles{
}

@* Filter part starting.... *@
<div class="card">
    <div class="card-header">
        <h3 class="card-title primary-text font-weight-bold"><i class="fas fa-filter"></i> Filters</h3>
        <div class="card-tools">
            <button class="btn btn-tool" type="button" data-toggle="collapse" data-target="#filterCard" aria-expanded="false" aria-controls="filterCard">
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
    <div class="collapse" id="filterCard">
        <div class="card-body">
            <form id="filterForm">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Date</label>
                            <input type="text" class="form-control" name="Date" autocomplete="off" placeholder="Select a date range">
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>Action</label>
                            <select class="form-control js-select2" name="Action">
                                <option value="">All Actions</option>
                                @foreach (var action in actionList)
                                {
                                    <option value="@action">@action</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="form-group">
                            <label>User</label>
                            <select class="form-control js-select2" name="Username">
                                <option value="">All Users</option>
                                @foreach (var username in usernameList)
                                {
                                    <option value="@username">@username</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Sort By</label>
                                    <select class="form-control js-select2" name="SortBy">
                                        <option value="CreatedOn" selected>Latest</option>
                                        <option value="Username">User</option>
                                        <option value="Action">Action</option>
                                        <option value="EntityType">Entity</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 pl-0">
                                <div class="form-group">
                                    <label>Order</label>
                                    <select class="form-control js-select2" name="SortByOrder">
                                        <option value="DESC" selected>Descending</option>
                                        <option value="ASC">Ascending</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-3 ml-auto">
                        <div class="form-group mb-0 d-flex justify-content-between">
                            <label></label>
                            <button type="button" class="btn btn-primary-custom form-control text-nowrap js-apply-filter-btn">Apply Filter</button>
                            <button type="button" class="btn btn-default form-control js-clear-filter-btn ml-2">Clear Filter</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@* Filter part ending .... *@

@* Table part starting ... *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-baseline">
        <h3 class="card-title primary-text font-weight-bold">Audit Logs</h3>
    </div>
    <div class="card-body">
        <table id="reportTable" class="table table-hover w-100 table-responsive-sm">
            <thead>
                <tr>
                    <th>Date &amp; Time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
@* Table part ending .... *@
@section Scripts{
    <script>
        var GetAuditLogsReportUrl = '@Url.Action("GetAuditLogsReport", "Reports")';
    </script>
    <script src="~/panel-assets/plugins/DateRange/moment.min.js"></script>
    <script src="~/panel-assets/plugins/DateRange/daterangepicker.js"></script>
    <script src="~/JSModels/Reports/auditLogsReport.js"></script>
}
